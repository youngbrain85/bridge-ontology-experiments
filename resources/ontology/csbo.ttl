@prefix csbo: <https://example.org/csbo#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty .

<https://example.org/csbo> a owl:Ontology ;
    rdfs:label "Ontology for drawing-based 3D generation of cable-stayed bridges"@en ;
    dcterms:created "2026-09-06"^^xsd:date ;
    rdfs:comment "Local research draft. Contains no numeric answer key, automatic scoring or engineering design verification. Rules are annotations, not executable constraints."@en ;
    owl:versionIRI <https://example.org/csbo/0.1.0-en.1> ;
    owl:versionInfo "0.1.0-en.1" .

csbo:evidenceBasis a owl:AnnotationProperty .

csbo:factId a owl:AnnotationProperty .

csbo:scope a owl:AnnotationProperty .

csbo:GirderAnchoragePlateCenter a csbo:ReferencePointRole ;
    rdfs:label "Girder-side anchorage plate center"@en ;
    skos:definition "The reference-point role identifying the center of a girder-side or stiffening-girder-side anchorage plate. Determine coordinates from project drawings."@en .

csbo:PylonAnchoragePlateCenter a csbo:ReferencePointRole ;
    rdfs:label "Pylon-side anchorage plate center"@en ;
    skos:definition "The reference-point role identifying the center of a pylon-side anchorage plate. Distinguish it from a tube endpoint."@en .

csbo:PylonTubeEndPoint a csbo:ReferencePointRole ;
    rdfs:label "Pylon-side tube endpoint"@en ;
    skos:definition "The reference-point role identifying a tube endpoint on the pylon side. Distinguish it from an anchorage plate center."@en .

csbo:DeckZone a owl:Class ;
    rdfs:label "Superstructure zone"@en ;
    rdfs:subClassOf csbo:SpatialZone ;
    skos:definition "A space subdividing the superstructure into panels, segments, construction zones or similar divisions. Record the subdivision criteria."@en .

csbo:Foundation a owl:Class ;
    rdfs:label "Foundation"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:definition "A foundation assembly transferring loads from above to the ground or other supporting medium. Its type, such as piled or spread foundation, is project-specific information."@en .

csbo:TieDownAnchorage a owl:Class ;
    rdfs:label "Tie-down anchorage"@en ;
    rdfs:subClassOf csbo:AnchorageAssembly ;
    skos:definition "An assembly anchoring a tie-down tensile element to its supporting structure. Distinguish its role from a stay-cable anchorage."@en .

csbo:Abutment a owl:Class ;
    rdfs:label "Abutment"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "abutment"@en ;
    skos:definition "A physical component or assembly forming the support structure at a bridge end."@en .

csbo:CableDamper a owl:Class ;
    rdfs:label "Cable damper"@en ;
    rdfs:subClassOf csbo:AuxiliaryComponent ;
    skos:altLabel "damper"@en ;
    skos:definition "A component for cable vibration control. Model it when its presence and installation point are confirmed in the drawings."@en .

csbo:ExpansionJoint a owl:Class ;
    rdfs:label "Expansion joint"@en ;
    rdfs:subClassOf csbo:PhysicalComponent ;
    skos:altLabel "expansion joint device"@en ;
    skos:definition "A joint device accommodating designed structural displacement. Distinguish it from a simple line depicting a joint."@en .

csbo:Pile a owl:Class ;
    rdfs:label "Pile"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "pile"@en ;
    skos:definition "A pile component forming part of a foundation. Verify pile count, diameter, inclination and length from the drawings."@en .

csbo:PylonCrossbeam a owl:Class ;
    rdfs:label "Pylon crossbeam"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "pylon transverse beam"@en ;
    skos:definition "A crossbeam connecting pylon legs or similar parts. Do not assume that every pylon has one."@en .

csbo:PylonLeg a owl:Class ;
    rdfs:label "Pylon leg"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "tower leg"@en ;
    skos:definition "A column or tower-leg component forming a pylon. Determine its section, inclination and segmentation from the drawings."@en .

csbo:R03 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:AnchorageBearingPlate,
        csbo:Bearing ;
    csbo:ruleAction "Distinguish a plate distributing anchorage force as AnchorageBearingPlate from a bearing device between superstructure and substructure as Bearing. Do not determine the type from the word alone."@en ;
    csbo:ruleCondition "When interpreting Bearing Plate or bearing-related annotations"@en .

csbo:R12 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:DrawingView,
        csbo:ParameterAssignment ;
    csbo:ruleAction "Consider scale, enlarged details and not-to-scale annotations. Verify where stated dimensions apply; do not overwrite evidenced annotated dimensions with pixel measurements."@en ;
    csbo:ruleCondition "When using annotated dimensions together with lengths measured on screen"@en .

csbo:R17 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:ConnectionSpecification,
        csbo:connectedTo ;
    csbo:ruleAction "Verify connections from drawing details or connection annotations. Contact, penetration or proximity alone does not establish connectedTo, anchorage or rigid connection."@en ;
    csbo:ruleCondition "When lines, solids or components touch or intersect"@en .

csbo:R21 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:DrawingMention,
        csbo:Revision ;
    csbo:ruleAction "Distinguish actually placed elements from invisible layers, unused block definitions and default attribute text. Do not infer the current presence of a component solely from unused definitions or revision history."@en ;
    csbo:ruleCondition "When using CAD text, blocks or layers as evidence"@en .

csbo:R24 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:AnchorageAssembly,
        csbo:SourceReference ;
    csbo:ruleAction "Record the need for the reference and the unresolved items. Do not complete a missing XREF or the internal geometry of a supplier's anchorage from general knowledge."@en ;
    csbo:ruleCondition "When a referenced detail, external reference or supplier detail is absent from the current input"@en .

csbo:R28 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:GeometryDefinition,
        csbo:PhysicalComponent ;
    csbo:ruleAction "Decide according to the common specified modeling target and detail level. Do not generate a component absent from the drawings merely because its concept exists in the ontology."@en ;
    csbo:ruleCondition "When deciding whether to generate a component shown in the drawings"@en .

csbo:R30 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:GenerationRule,
        csbo:hasEvidence ;
    csbo:ruleAction "Record the inference basis and uncertainty. OWL domain, range, inverse and symmetric relationships are axioms for interpreting input meaning; do not treat them as checks that automatically identify drawing omissions or engineering correctness."@en ;
    csbo:ruleCondition "When inferring relationships absent from the drawings using general knowledge"@en .

csbo:SpanZone a owl:Class ;
    rdfs:label "Span zone"@en ;
    rdfs:subClassOf csbo:SpatialZone ;
    skos:altLabel "span"@en ;
    skos:definition "A spatial span zone bounded by project-defined criteria, such as adjacent support locations. Span length is separate project information."@en .

csbo:SteelBoxGirder a owl:Class ;
    rdfs:label "Steel box stiffening girder"@en ;
    rdfs:subClassOf csbo:StiffeningGirder ;
    skos:altLabel "steel box girder"@en ;
    skos:definition "A stiffening girder with a box section formed from steel plates or similar elements. Internal diaphragms and stiffeners may be represented as separate components."@en .

csbo:WindRestraint a owl:Class ;
    rdfs:label "Wind restraint"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "wind restraint device"@en ;
    skos:definition "A support or restraint device responding to wind loads or similar actions in designed directions. Distinguish it from bridge bearings and tie-downs by its actual function and assembly relationships."@en .

csbo:basis a owl:DatatypeProperty ;
    rdfs:label "Evidence assessment basis"@en ;
    rdfs:domain csbo:SourceReference ;
    rdfs:range xsd:string ;
    skos:definition "A string explaining whether information was directly observed or inferred and how it was interpreted."@en .

csbo:depicts a owl:ObjectProperty ;
    rdfs:label "depicts an entity"@en ;
    rdfs:domain csbo:DrawingView ;
    rdfs:range csbo:Entity ;
    skos:definition "Links a view to an entity depicted in it. This relationship neither owns the component nor creates a new instance."@en .

csbo:filePath a owl:DatatypeProperty ;
    rdfs:label "File path"@en ;
    rdfs:domain csbo:DrawingFile ;
    rdfs:range xsd:string ;
    skos:definition "The current storage path. Different paths may contain the same content."@en .

csbo:hasCoordinateFrame a owl:ObjectProperty ;
    rdfs:label "uses a coordinate frame"@en ;
    rdfs:domain csbo:Entity ;
    rdfs:range csbo:CoordinateFrame ;
    skos:definition "Links a drawing view or coordinate-based modeling information to its interpretation frame. Use separate frames for drawing-plane and physical-object coordinates."@en .

csbo:hasGeometry a owl:ObjectProperty ;
    rdfs:label "has a geometry definition"@en ;
    rdfs:domain csbo:PhysicalComponent ;
    rdfs:range csbo:GeometryDefinition ;
    skos:definition "Links a physical component to a geometry representation. A component may have different geometry representations for different levels of detail or states."@en .

csbo:hasMaterial a owl:ObjectProperty ;
    rdfs:label "has a material specification"@en ;
    rdfs:domain csbo:PhysicalComponent ;
    rdfs:range csbo:MaterialSpecification ;
    skos:definition "Links a physical component to a material specification."@en .

csbo:hasMention a owl:ObjectProperty ;
    rdfs:label "contains a drawing mention"@en ;
    rdfs:domain csbo:DrawingView ;
    rdfs:range csbo:DrawingMention ;
    skos:definition "Links a view to a drawing mention within it."@en .

csbo:hasParameter a owl:ObjectProperty ;
    rdfs:label "has a parameter assignment"@en ;
    rdfs:domain csbo:Entity ;
    rdfs:range csbo:ParameterAssignment ;
    skos:definition "Links an entity to a parameter record containing its value, unit, source and certainty status."@en .

csbo:hasSectionAssignment a owl:ObjectProperty ;
    rdfs:label "has a section assignment"@en ;
    rdfs:domain csbo:GeometryDefinition ;
    rdfs:range csbo:SectionAssignment ;
    skos:definition "Links geometry generation to the applicable section and its station or zone information."@en .

csbo:hasSheet a owl:ObjectProperty ;
    rdfs:label "contains a sheet"@en ;
    rdfs:domain csbo:DrawingFile ;
    rdfs:range csbo:DrawingSheet ;
    skos:definition "Links a file to a sheet within it."@en .

csbo:hasView a owl:ObjectProperty ;
    rdfs:label "contains a view"@en ;
    rdfs:domain csbo:DrawingSheet ;
    rdfs:range csbo:DrawingView ;
    skos:definition "Links a sheet to a plan, elevation, section or detail view within it."@en .

csbo:identifier a owl:DatatypeProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:domain csbo:Entity ;
    rdfs:range xsd:string ;
    skos:definition "A project-scoped identifier distinguishing an entity. Equal names or annotations do not imply the same entity."@en .

csbo:locator a owl:DatatypeProperty ;
    rdfs:label "Source locator"@en ;
    rdfs:domain csbo:SourceReference ;
    rdfs:range xsd:string ;
    skos:definition "A location that a person can find again within a file, such as a page, layout, view, handle or region."@en .

csbo:numericValue a owl:DatatypeProperty ;
    rdfs:label "Numeric value"@en ;
    rdfs:domain csbo:ParameterAssignment ;
    rdfs:range xsd:double ;
    skos:definition "An evidenced numeric value. Do not record an unresolved value as an arbitrary zero."@en .

csbo:parameterName a owl:DatatypeProperty ;
    rdfs:label "Parameter name"@en ;
    rdfs:domain csbo:ParameterAssignment ;
    rdfs:range xsd:string ;
    skos:definition "A name indicating the meaning of a value, such as width, thickness or length. Specify the value's reference point and state separately."@en .

csbo:revisionLabel a owl:DatatypeProperty ;
    rdfs:label "Revision label"@en ;
    rdfs:domain csbo:Revision ;
    rdfs:range xsd:string ;
    skos:definition "A revision identifier verified from the drawing. Distinguish it from the file modification timestamp."@en .

csbo:sourceFile a owl:ObjectProperty ;
    rdfs:label "references a source file"@en ;
    rdfs:domain csbo:SourceReference ;
    rdfs:range csbo:DrawingFile ;
    skos:definition "Indicates the file containing a source location reference."@en .

csbo:textValue a owl:DatatypeProperty ;
    rdfs:label "Text value"@en ;
    rdfs:domain csbo:ParameterAssignment ;
    rdfs:range xsd:string ;
    skos:definition "A nonnumeric parameter value or original annotation. It may be preserved alongside parsed numbers and units."@en .

csbo:zonePartOf a owl:ObjectProperty ;
    rdfs:label "is part of a spatial subdivision"@en ;
    rdfs:domain csbo:SpatialZone ;
    rdfs:range csbo:AssetEntity ;
    skos:definition "Indicates that a zone belongs to the spatial subdivision of a larger zone or bridge. Distinguish it from physical assembly relationships."@en .

csbo:AnchorageZone a owl:Class ;
    rdfs:label "Anchorage zone"@en ;
    rdfs:subClassOf csbo:SpatialZone ;
    skos:definition "A spatial subdivision containing an anchorage and local reinforcing components. This does not mean that every component within it belongs to the same anchorage assembly."@en .

csbo:CableSaddle a owl:Class ;
    rdfs:label "Cable saddle"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "cable guide saddle"@en,
        "saddle"@en ;
    skos:definition "A saddle component supporting and guiding the path of a continuous cable or similar element. Represent it when confirmed in the drawings; do not automatically equate it with an end anchorage."@en .

csbo:CableSegment a owl:Class ;
    rdfs:label "Physical cable segment"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:definition "A portion of an actual cable identified in a segmented model. It is not the same concept as a geometric line segment."@en .

csbo:CurvedCablePath a owl:Class ;
    rdfs:label "Curved cable path"@en ;
    rdfs:subClassOf csbo:CablePath ;
    skos:definition "A cable path representing sag, curvature or similar features. Specify curve equations and control points only when supported by evidence."@en .

csbo:DeckAssembly a owl:Class ;
    rdfs:label "Deck assembly"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:definition "A physical assembly grouping the deck and related components. Distinguish it from an individual slab."@en .

csbo:DrainageComponent a owl:Class ;
    rdfs:label "Drainage component"@en ;
    rdfs:subClassOf csbo:AuxiliaryComponent ;
    skos:altLabel "drainage inlet"@en,
        "drainage pipe"@en ;
    skos:definition "A component serving drainage functions, such as a drainage pipe or inlet."@en .

csbo:LoftGeometry a owl:Class ;
    rdfs:label "Loft geometry definition"@en ;
    rdfs:subClassOf csbo:GeometryDefinition ;
    skos:definition "A representation creating a shape by connecting sections at multiple positions. Distinguish section positions, order, profile correspondence and transition method."@en .

csbo:MaterialSpecification a owl:Class ;
    rdfs:label "Material specification"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:definition "A specification of material type, grade or similar attributes. Do not determine steel grade, concrete strength or similar values from a component name alone."@en .

csbo:PierZone a owl:Class ;
    rdfs:label "Pier zone"@en ;
    rdfs:subClassOf csbo:SpatialZone ;
    skos:definition "A spatial zone corresponding to an evidenced pier-location identifier such as P9 or P10. It is a separate entity from the physical pier."@en .

csbo:PlateGeometry a owl:Class ;
    rdfs:label "Plate geometry definition"@en ;
    rdfs:subClassOf csbo:GeometryDefinition ;
    skos:definition "A plate-generation representation using a section or planar profile, thickness, orientation and openings. Do not automatically copy dimensions from another plate."@en .

csbo:PylonZone a owl:Class ;
    rdfs:label "Pylon zone"@en ;
    rdfs:subClassOf csbo:SpatialZone ;
    skos:definition "A spatial subdivision containing a pylon and related components. It is not the physical pylon assembly itself."@en .

csbo:R01 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:DrawingMention,
        csbo:PhysicalComponent,
        csbo:refersTo ;
    csbo:ruleAction "Compare component numbers, installation zones, referenced details and revisions to determine whether mentions refer to the same physical instance. Initially keep repeated depictions as separate DrawingMention entities, linking them to the same component only when supported by evidence."@en ;
    csbo:ruleCondition "When the same name or component annotation appears in several views or files"@en .

csbo:R05 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:PrestressingAnchorage,
        csbo:PrestressingBar,
        csbo:StayCableAnchorage ;
    csbo:ruleAction "Represent the main stay cable and tendons reinforcing the anchorage region as separate entities. Do not automatically merge plates or anchorages of the reinforcing tendons with the stay-cable anchorage."@en ;
    csbo:ruleCondition "When PT BAR or prestressing strand is also shown near an anchorage"@en .

csbo:R07 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CurvedCablePath,
        csbo:ModelState,
        csbo:StraightCablePath ;
    csbo:ruleAction "Check alignment drawings, sag annotations, coordinates, length definitions and the model reference state. Choose a straight path only when defined by the drawing or declared as a simplification; do not invent sag values, curve equations or control points without evidence."@en ;
    csbo:ruleCondition "When choosing a straight or curved cable representation"@en .

csbo:R09 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:AnchorageAssembly,
        csbo:CablePath,
        csbo:CableSegment ;
    csbo:ruleAction "Segment according to saddles, deviation points, splices and similar features confirmed in the drawings, and according to the model detail level. Do not impose a universal constraint that every stay cable has exactly two physical anchorage assemblies."@en ;
    csbo:ruleCondition "When dividing a cable into one or multiple segments"@en .

csbo:R10 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CoordinateFrame,
        csbo:DrawingView,
        csbo:parentFrame ;
    csbo:ruleAction "First verify each view's and block's coordinate system, projection, axes, scale, rotation and insertion transform. CAD text extraction text.position is a text placement point, not a physical-object coordinate. Do not directly use block-local coordinates as global bridge coordinates either."@en ;
    csbo:ruleCondition "When combining plan, elevation, section, detail or block coordinates"@en .

csbo:R11 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CoordinateFrame,
        csbo:ParameterAssignment,
        csbo:unitSymbol ;
    csbo:ruleAction "Check dimension annotations, unit labels, coordinate tables and consistent reference dimensions. Do not determine physical dimension units solely from CAD file unit metadata or output image size. Preserve conflicting values and their sources and leave them unresolved."@en ;
    csbo:ruleCondition "When reading numbers, dimensions and coordinates from drawings"@en .

csbo:R13 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CoordinateFrame,
        csbo:ParameterAssignment,
        csbo:ReferencePoint ;
    csbo:ruleAction "Preserve unresolved coordinates, directions and transformations. Do not fill missing information with a definitive origin, identity matrix or symmetric location without evidence."@en ;
    csbo:ruleCondition "When placing a component with insufficient reference-point or location information"@en .

csbo:R14 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CableStayedBridge,
        csbo:Pylon,
        csbo:StayCable ;
    csbo:ruleAction "Determine component counts, cable arrangements, spacing, symmetry, pylon count and section types from project evidence. A cable-stayed bridge classification alone does not establish equal spacing, symmetry or a specific cable count."@en ;
    csbo:ruleCondition "When a layout drawing shows a repeated pattern"@en .

csbo:R15 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CastInPlaceDeckPart,
        csbo:DeckAssembly,
        csbo:PrecastDeckPanel ;
    csbo:ruleAction "Distinguish PrecastDeckPanel from CastInPlaceDeckPart and preserve actual subdivisions, joints and repeated-instance numbers. Do not merge them into one mass solely because they belong to the same overall deck."@en ;
    csbo:ruleCondition "When precast panels and cast-in-place portions are both defined"@en .

csbo:R19 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:DrawingMention,
        csbo:PierZone,
        csbo:ReinforcementBar ;
    csbo:ruleAction "Use the drawing context to determine whether the annotation denotes a rebar mark, component number or pier location. Do not interpret the CAD control sequence %%p for the plus/minus symbol as a pier P."@en ;
    csbo:ruleCondition "When reading short annotations such as P1, P2, A1 or A2"@en .

csbo:R20 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:PhysicalComponent,
        csbo:SpatialZone,
        csbo:locatedIn ;
    csbo:ruleAction "Identify PylonZone, PierZone and DeckZone separately from physical components such as Pylon, Pier and Girder, and connect them with locatedIn. Do not model a spatial subdivision as a physical component."@en ;
    csbo:ruleCondition "When recording pylon, pier or superstructure zones and their physical components"@en .

csbo:R23 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:DrawingFile,
        csbo:derivedFrom,
        csbo:sha256 ;
    csbo:ruleAction "Preserve original content identifiers and derivation relationships. Do not count copies or enlarged captures of the same drawing as multiple independent design sources."@en ;
    csbo:ruleCondition "When using classified-folder copies, PDFs, PNGs and DXFs together"@en .

csbo:R25 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:ParameterAssignment,
        csbo:SourceReference,
        csbo:hasEvidence ;
    csbo:ruleAction "Distinguish directly read information from inference and record sources such as file, sheet, view, detail and handle. Do not use ontology definitions as evidence proving numeric values or connection facts for this bridge."@en ;
    csbo:ruleCondition "When determining component dimensions, materials, coordinates or relationships"@en .

csbo:R26 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:GeometryDefinition,
        csbo:ParameterAssignment,
        csbo:valueStatus ;
    csbo:ruleAction "Preserve the identified component and confirmed information; state unresolved values, conflicts and omitted geometry. Continue describing the model to the extent possible even when not every detail is known."@en ;
    csbo:ruleCondition "When the component type is known but some dimensions or relationships are unknown"@en .

csbo:R35 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:AnchorageTube,
        csbo:CableSheath,
        csbo:TubeGeometry ;
    csbo:ruleAction "Verify the tube's reference path, length range, outer and inner sections, units and placement. Do not automatically reuse a cable's outside diameter as the outside or inside diameter of an anchorage tube."@en ;
    csbo:ruleCondition "When generating the geometry of anchorage tubes or protective sheaths"@en .

csbo:R37 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:ReferencePoint,
        csbo:pointRole,
        csbo:referencePointOf ;
    csbo:ruleAction "Use pointRole together with referencePointOf to record which reference point belongs to which component. For example, the role of anchorage plate center alone does not justify merging pylon-side and girder-side reference points into one entity."@en ;
    csbo:ruleCondition "When reference points with the same role occur at multiple locations"@en .

csbo:Railing a owl:Class ;
    rdfs:label "Railing or protective barrier component"@en ;
    rdfs:subClassOf csbo:AuxiliaryComponent ;
    skos:altLabel "railing"@en,
        "safety barrier"@en ;
    skos:definition "A railing, parapet or safety barrier component at a deck edge or similar location. Record its detailed type as a separate property."@en .

csbo:ShearConnector a owl:Class ;
    rdfs:label "Shear connector"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "shear connector"@en,
        "stud"@en ;
    skos:definition "A connecting component transferring shear between different components. Stud counts and arrangements require separate evidence."@en .

csbo:StraightCablePath a owl:Class ;
    rdfs:label "Straight cable path"@en ;
    rdfs:subClassOf csbo:CablePath ;
    skos:definition "A cable geometry representation declared as one straight segment. Selecting this type does not mean that all stay cables are straight."@en .

csbo:SweepGeometry a owl:Class ;
    rdfs:label "Sweep geometry definition"@en ;
    rdfs:subClassOf csbo:GeometryDefinition ;
    skos:definition "A generation representation moving a section along a reference path. It requires the path, section, section orientation and application range; algorithm syntax is defined by a separate generator."@en .

csbo:TubeGeometry a owl:Class ;
    rdfs:label "Tube geometry definition"@en ;
    rdfs:subClassOf csbo:GeometryDefinition ;
    skos:definition "A tube-generation representation using a path and outer and inner sections. Preserve unknown outside diameter, inside diameter or thickness values as unresolved."@en .

csbo:hasEndPoint a owl:ObjectProperty ;
    rdfs:label "has a path end point"@en ;
    rdfs:domain csbo:CablePath ;
    rdfs:range csbo:ReferencePoint ;
    rdfs:subPropertyOf csbo:hasReferencePoint ;
    skos:definition "The endpoint of a cable path described in a chosen direction. Record its role separately, such as an anchorage plate center or tube endpoint."@en .

csbo:hasPart a owl:ObjectProperty ;
    rdfs:label "has a physical part"@en ;
    rdfs:domain csbo:AssetEntity ;
    rdfs:range csbo:PhysicalComponent ;
    owl:inverseOf csbo:partOf ;
    skos:definition "The inverse relationship of partOf. Distinguish it from subdivision of a spatial zone."@en .

csbo:hasStartPoint a owl:ObjectProperty ;
    rdfs:label "has a path start point"@en ;
    rdfs:domain csbo:CablePath ;
    rdfs:range csbo:ReferencePoint ;
    rdfs:subPropertyOf csbo:hasReferencePoint ;
    skos:definition "The starting point of a cable path described in a chosen direction. It is not the same entity as the physical anchorage assembly."@en .

csbo:prestressAnchoredAt a owl:ObjectProperty ;
    rdfs:label "is anchored at a prestressing anchorage"@en ;
    rdfs:domain csbo:PrestressingTendon ;
    rdfs:range csbo:PrestressingAnchorage ;
    rdfs:subPropertyOf csbo:anchoredAt ;
    skos:definition "Connects a prestressing tendon to its anchorage."@en .

csbo:CableStayedBridge a owl:Class ;
    rdfs:label "Cable-stayed bridge"@en ;
    rdfs:subClassOf csbo:Bridge ;
    skos:altLabel "cable-stayed bridge"@en ;
    skos:definition "A bridge in which stay cables form structural support relationships between pylons and girders or the superstructure. Pylon shape and cable arrangement are project-specific information."@en .

csbo:CastInPlaceDeckPart a owl:Class ;
    rdfs:label "Cast-in-place deck part"@en ;
    rdfs:subClassOf csbo:DeckSlab ;
    skos:altLabel "cast-in-place portion"@en ;
    skos:definition "A deck portion cast on site or a cast-in-place zone between panels. Identify it by the project's subdivision boundaries."@en .

csbo:Pier a owl:Class ;
    rdfs:label "Pier"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "pier"@en ;
    skos:definition "A physical pier component or assembly supporting the superstructure or similar elements. Distinguish it from a spatial zone identifying the pier location."@en .

csbo:R06 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CablePath,
        csbo:ReferencePoint,
        csbo:ReferencePointRole,
        csbo:pointRole ;
    csbo:ruleAction "Preserve reference-point roles, such as anchorage plate center, tube endpoint or cable reference-line intersection. Verify drawing abbreviations and state which reference points the start and end points represent."@en ;
    csbo:ruleCondition "When constructing a stay cable's 3D path"@en .

csbo:R08 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CablePath,
        csbo:ModelState,
        csbo:ParameterAssignment,
        csbo:atState ;
    csbo:ruleAction "Check that values use the same pre- or post-stressing state and reference-point definitions. Do not automatically equate straight distance between anchorage points, curved path length, fabrication length and stressed cable length."@en ;
    csbo:ruleCondition "When combining cable length, distance between anchorages and direction angles"@en .

csbo:R22 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:ModelState,
        csbo:Revision,
        csbo:hasRevision,
        csbo:supersedes ;
    csbo:ruleAction "Check revision annotations, reference relationships and application scope, and preserve conflicting information. Do not select the latest valid dimension solely by modification time or filename, or combine drawings representing different states."@en ;
    csbo:ruleCondition "When values differ between drawings or revisions are mixed"@en .

csbo:R27 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:AnchorageTube,
        csbo:CableSheath,
        csbo:GeometryDefinition,
        csbo:StayCable ;
    csbo:ruleAction "Distinguish section reference lines, centerlines and outlines, and the boundaries of protective sheaths, metallic tensile elements and anchorage parts. Do not automatically reuse one part's diameter or thickness for another part."@en ;
    csbo:ruleCondition "When using widths, thicknesses, diameters and outside diameters to generate solids"@en .

csbo:R29 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:Pylon,
        csbo:PylonZone,
        csbo:StayCable,
        csbo:StayCableAnchorage ;
    csbo:ruleAction "Distinguish physical and spatial roles when mapping. Do not map a stay cable to the electrical or communication IfcCableSegment, and do not equate a stay-cable anchorage with IfcTendonAnchor in every case."@en ;
    csbo:ruleCondition "When selecting types for IFC export"@en .

csbo:R31 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:ComponentType,
        csbo:CrossSectionDefinition,
        csbo:PhysicalComponent,
        csbo:hasComponentType ;
    csbo:ruleAction "Determine whether the role is a ComponentType definition, CrossSectionDefinition, individual installed PhysicalComponent or SpatialZone. Do not treat one heading as a unique actual cable or anchorage. Actual installed instances of the same type have different identifiers."@en ;
    csbo:ruleCondition "When reading headings or type numbers such as CA48 or TYPE-A1"@en .

csbo:R32 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:AnchorageBearingPlate,
        csbo:AnchorageTube,
        csbo:CablePath,
        csbo:CoordinateFrame ;
    csbo:ruleAction "Distinguish reference planes, signs, angular units and axis order for side-view or front-view projection angles and in-plane angles. Do not automatically equate the direction joining two cable reference points with the end tangent direction accounting for sag."@en ;
    csbo:ruleCondition "When using cable, anchorage plate or tube angles and axis directions"@en .

csbo:R34 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:Diaphragm,
        csbo:PlateGeometry,
        csbo:SteelPlate,
        csbo:Stiffener ;
    csbo:ruleAction "Associate each plate's profile, thickness, reference plane, orientation and installation point using the drawings. Generate openings, bolts, welds and similar details when supported by the requested detail level and drawing evidence; leave them as missing items when information is absent."@en ;
    csbo:ruleCondition "When generating anchorage plates, gusset plates, end plates, diaphragms or stiffeners"@en .

csbo:R36 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:AnchorageAssembly,
        csbo:AnchorageZone,
        csbo:locatedIn,
        csbo:partOf ;
    csbo:ruleAction "Distinguish AnchorageZone as a space from AnchorageAssembly as a physical assembly. Do not automatically merge all reinforcing bars, PT bars and anchorage plates in the same zone into one anchorage's components."@en ;
    csbo:ruleCondition "When multiple parts appear within a pylon or stiffening-girder anchorage region"@en .

csbo:ReinforcementBar a owl:Class ;
    rdfs:label "Reinforcing bar"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "rebar"@en ;
    skos:definition "A reinforcing bar used in concrete. Distinguish a rebar mark from a pier or zone identifier."@en .

csbo:atState a owl:ObjectProperty ;
    rdfs:label "is defined at a reference state"@en ;
    rdfs:domain csbo:ModelingEntity ;
    rdfs:range csbo:ModelState ;
    skos:definition "Indicates the construction, stressing or completed state corresponding to geometry, parameters or similar information."@en .

csbo:derivedFrom a owl:ObjectProperty ;
    rdfs:label "is derived from another drawing file"@en ;
    rdfs:domain csbo:DrawingFile ;
    rdfs:range csbo:DrawingFile ;
    skos:definition "An evidenced derivation relationship, such as export, conversion or extraction. The number of copied paths does not represent the number of independent drawings."@en .

csbo:hasComponentType a owl:ObjectProperty ;
    rdfs:label "has a component type"@en ;
    rdfs:domain csbo:PhysicalComponent ;
    rdfs:range csbo:ComponentType ;
    skos:definition "Links an individual installed component to a type definition. Components sharing a type are not the same physical entity."@en .

csbo:hasConnectionSpecification a owl:ObjectProperty ;
    rdfs:label "has a connection specification"@en ;
    rdfs:domain csbo:PhysicalComponent ;
    rdfs:range csbo:ConnectionSpecification ;
    skos:definition "Links a component to its connection and restraint specification. State the lack of evidence if the actual conditions are unresolved."@en .

csbo:hasRevision a owl:ObjectProperty ;
    rdfs:label "has revision information"@en ;
    rdfs:domain csbo:DrawingFile ;
    rdfs:range csbo:Revision ;
    skos:definition "Links a file to its revision information."@en .

csbo:mountedOn a owl:ObjectProperty ;
    rdfs:label "is mounted on a host component"@en ;
    rdfs:domain csbo:PhysicalComponent ;
    rdfs:range csbo:PhysicalComponent ;
    skos:definition "Identifies the actual host component on which an anchorage or other component is installed. Record the host type and location with evidence."@en .

csbo:parentFrame a owl:ObjectProperty ;
    rdfs:label "has a parent coordinate frame"@en ;
    rdfs:domain csbo:CoordinateFrame ;
    rdfs:range csbo:CoordinateFrame ;
    skos:definition "The parent coordinate frame used as the target when specifying a frame transformation. Record the transformation values separately."@en .

csbo:referencePointOf a owl:ObjectProperty ;
    rdfs:label "is a reference point of a component"@en ;
    rdfs:domain csbo:ReferencePoint ;
    rdfs:range csbo:PhysicalComponent ;
    skos:definition "Links an anchorage plate center, tube endpoint or similar point to its actual reference component. Equal point roles do not establish equal reference components."@en .

csbo:refersTo a owl:ObjectProperty ;
    rdfs:label "refers to an entity"@en ;
    rdfs:domain csbo:DrawingMention ;
    rdfs:range csbo:Entity ;
    skos:definition "Links a drawing mention to the entity it identifies. A mention may refer to a collection, type or space."@en .

csbo:sha256 a owl:DatatypeProperty ;
    rdfs:label "Content hash"@en ;
    rdfs:domain csbo:DrawingFile ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the original bytes. It tracks duplicate files and does not establish identity of component instances."@en .

csbo:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes an earlier revision"@en ;
    rdfs:domain csbo:Revision ;
    rdfs:range csbo:Revision ;
    skos:definition "A confirmed revision succession relationship. Do not assert it solely from filename order or modification timestamps."@en .

csbo:supports a owl:ObjectProperty ;
    rdfs:label "structurally supports"@en ;
    rdfs:domain csbo:StructuralComponent ;
    rdfs:range csbo:StructuralComponent ;
    skos:definition "An evidenced structural support relationship. This relationship alone does not determine analysis-model boundary conditions or load-sharing ratios."@en .

csbo:unitSymbol a owl:DatatypeProperty ;
    rdfs:label "Unit symbol"@en ;
    rdfs:domain csbo:ModelingEntity ;
    rdfs:range xsd:string ;
    skos:definition "The unit of a parameter, coordinate frame or similar entity. Do not determine physical drawing-dimension units from DWG metadata alone."@en .

csbo:usesSection a owl:ObjectProperty ;
    rdfs:label "uses a section definition"@en ;
    rdfs:domain csbo:SectionAssignment ;
    rdfs:range csbo:CrossSectionDefinition ;
    skos:definition "Indicates the section definition used by a section assignment."@en .

csbo:valueStatus a owl:DatatypeProperty ;
    rdfs:label "Value status"@en ;
    rdfs:domain csbo:ParameterAssignment ;
    rdfs:range xsd:string ;
    skos:definition "A string specifying a parameter's status, such as directly read, inferred, unresolved or conflicting."@en .

csbo:Bridge a owl:Class ;
    rdfs:label "Bridge"@en ;
    rdfs:subClassOf csbo:AssetEntity ;
    owl:disjointWith csbo:PhysicalComponent ;
    skos:altLabel "bridge structure"@en ;
    skos:definition "One bridge asset, connected to its spans, components, zones and drawing set."@en .

csbo:ConnectionSpecification a owl:Class ;
    rdfs:label "Connection specification"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:definition "A specification describing contact, fastening, support, anchorage and mechanical restraint conditions separately. A simple connection relationship does not imply a rigid connection."@en .

csbo:DrawingSheet a owl:Class ;
    rdfs:label "Drawing sheet"@en ;
    rdfs:subClassOf csbo:EvidenceEntity ;
    skos:definition "A source unit within a file, such as a printed sheet, layout or PDF page. One file may contain multiple sheets."@en .

csbo:ElectricalCable a owl:Class ;
    rdfs:label "Electrical or communication cable"@en ;
    rdfs:subClassOf csbo:AuxiliaryComponent ;
    skos:altLabel "communication cable"@en,
        "power cable"@en ;
    skos:definition "A cable transmitting power, communication or data. Distinguish it from stay cables and tie-down cables."@en .

csbo:PrecastDeckPanel a owl:Class ;
    rdfs:label "Precast deck panel"@en ;
    rdfs:subClassOf csbo:DeckSlab ;
    skos:altLabel "PC panel"@en,
        "precast panel"@en ;
    skos:definition "An individual deck panel manufactured before installation. Distinguish it from cast-in-place joints."@en .

csbo:R02 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:ElectricalCable,
        csbo:PrestressingBar,
        csbo:PrestressingTendon,
        csbo:StayCable,
        csbo:TieDownCable ;
    csbo:ruleAction "Distinguish stay cables, prestressing tendons, prestressing bars, tie-downs and electrical or communication cables by their load-transfer roles and installation context. Do not create all of them as StayCable solely from part of an annotation."@en ;
    csbo:ruleCondition "When annotations mention cables, strands, bars or anchorages"@en .

csbo:R04 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:StayCable,
        csbo:StayCableAnchorage,
        csbo:mountedOn,
        csbo:partOf,
        csbo:stayAnchoredAt ;
    csbo:ruleAction "Record StayCable -> stayAnchoredAt -> StayCableAnchorage -> mountedOn -> the actual host component. Link anchorage plates, tubes and similar parts to the anchorage through confirmed assembly relationships. These relationships do not automatically determine specific coordinates or rigid connection conditions."@en ;
    csbo:ruleCondition "When stay-cable anchorage details and the installation host are confirmed"@en .

csbo:R16 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:Diaphragm,
        csbo:Stiffener,
        csbo:StiffeningGirder,
        csbo:TransverseBeam,
        csbo:partOf ;
    csbo:ruleAction "Record partOf relationships between the overall stiffening girder and its internal components. Generate only components included in the model detail level; do not add internal plates absent from the drawings solely from a general type."@en ;
    csbo:ruleCondition "When stiffening girders, transverse beams, diaphragms and stiffeners appear together"@en .

csbo:R33 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:CrossSectionDefinition,
        csbo:LoftGeometry,
        csbo:SectionAssignment,
        csbo:SweepGeometry,
        csbo:usesSection ;
    csbo:ruleAction "Link the reference path, applicable stations or zones of sections, section orientation and transition zones. Do not assume a constant section throughout from one section drawing. For lofting, record evidence for section order, profile correspondence and transition method."@en ;
    csbo:ruleCondition "When generating pylons or girders with section-based sweeps or lofts"@en .

csbo:R38 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:ComponentType,
        csbo:GeometryDefinition,
        csbo:PhysicalComponent,
        csbo:SourceReference,
        csbo:SpatialZone ;
    csbo:ruleAction "Put physical-component geometry in entities[].geometry and placement in entities[].pose. The meaning of hasGeometry and parameter records may be represented by these fields and entities[].properties without creating duplicate solids. When recording information or spatial entities such as ComponentType, SpatialZone, DrawingMention, GeometryDefinition or SourceReference as auxiliary entities, set geometry to null. Relationship target IDs must refer to IDs recorded in entities; record relationship evidence in source_evidence and confirmed, inferred or unresolved status in properties.status."@en ;
    csbo:ruleCondition "When recording generation results in the common intermediate model JSON"@en .

csbo:TieDownCable a owl:Class ;
    rdfs:label "Tie-down cable"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "tie-down"@en,
        "tie-down cable"@en ;
    skos:definition "A tensile tie-down cable providing restraint, for example against uplift. Do not automatically classify it as a stay cable."@en .

csbo:TransverseBeam a owl:Class ;
    rdfs:label "Superstructure transverse beam"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "cross beam"@en,
        "crossbeam"@en ;
    skos:definition "A beam arranged transversely in the superstructure. Distinguish it from a pylon crossbeam and verify connected components from the drawings."@en .

csbo:connectedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is physically connected to"@en ;
    rdfs:domain csbo:PhysicalComponent ;
    rdfs:range csbo:PhysicalComponent ;
    skos:definition "An evidenced physical connection relationship. It is symmetric but not transitive and does not imply rigid, hinged or degree-of-freedom conditions."@en .

csbo:stayAnchoredAt a owl:ObjectProperty ;
    rdfs:label "is anchored at a stay-cable anchorage"@en ;
    rdfs:domain csbo:StayCable ;
    rdfs:range csbo:StayCableAnchorage ;
    rdfs:subPropertyOf csbo:anchoredAt ;
    skos:definition "An anchorage relationship with an explicit role, connecting a stay cable to its stay-cable anchorage."@en .

csbo:Girder a owl:Class ;
    rdfs:label "Girder"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "girder"@en ;
    skos:definition "A beam or girder transmitting loads longitudinally or in another designed direction within the superstructure."@en .

csbo:R18 a csbo:GenerationRule ;
    csbo:relatedConcept csbo:Bearing,
        csbo:Girder,
        csbo:Pier,
        csbo:Pylon,
        csbo:hasConnectionSpecification,
        csbo:supports ;
    csbo:ruleAction "Distinguish structural support from rotation, movement and restraint conditions. Connection relationships do not propagate transitively to other components; do not convert them to fixed or hinged conditions without evidence."@en ;
    csbo:ruleCondition "When connecting pylons, girders, bearings and piers"@en .

csbo:SteelPlate a owl:Class ;
    rdfs:label "Steel plate"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "plate"@en ;
    skos:definition "A plate-shaped steel component. Its meaning, such as anchorage plate or web plate, depends on its role and installation location."@en .

csbo:anchoredAt a owl:ObjectProperty ;
    rdfs:label "is anchored at an anchorage"@en ;
    rdfs:domain csbo:StructuralComponent ;
    rdfs:range csbo:AnchorageAssembly ;
    skos:definition "A relationship anchoring a tensile component to an anchorage assembly. Do not assert it solely from proximity or intersecting lines."@en .

csbo:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has a source location reference"@en ;
    rdfs:domain csbo:Entity ;
    rdfs:range csbo:SourceReference ;
    skos:definition "Links a concept instance, value or relationship assertion to its evidence location. A domain definition does not replace direct evidence for a dimension in a specific drawing."@en .

csbo:hasReferencePoint a owl:ObjectProperty ;
    rdfs:label "has a reference point"@en ;
    rdfs:domain csbo:ModelingEntity ;
    rdfs:range csbo:ReferencePoint ;
    skos:definition "Links a geometry representation or similar entity to a reference point with a specified meaning."@en .

csbo:locatedIn a owl:ObjectProperty ;
    rdfs:label "is located in a zone"@en ;
    rdfs:domain csbo:PhysicalComponent ;
    rdfs:range csbo:SpatialZone ;
    skos:definition "Indicates the spatial zone containing a physical component. Equal locations do not establish component identity."@en .

csbo:pointRole a owl:ObjectProperty ;
    rdfs:label "has a reference point role"@en ;
    rdfs:domain csbo:ReferencePoint ;
    rdfs:range csbo:ReferencePointRole ;
    skos:definition "Links a point to a role describing its physical meaning. Do not merge points with different roles solely because they share coordinates."@en .

csbo:Bearing a owl:Class ;
    rdfs:label "Bridge bearing"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "bearing"@en,
        "bridge bearing"@en ;
    skos:definition "A device between the superstructure and supporting substructure that transfers loads and accommodates designed movement or rotation. Distinguish it from an anchorage bearing plate."@en .

csbo:CableSheath a owl:Class ;
    rdfs:label "Cable sheath"@en ;
    rdfs:subClassOf csbo:AuxiliaryComponent ;
    skos:altLabel "HDPE pipe"@en,
        "protective covering"@en ;
    skos:definition "A tube or covering protecting a stay cable or similar element. Do not confuse its outside diameter with that of the internal tensile element."@en .

csbo:DeckSlab a owl:Class ;
    rdfs:label "Deck slab"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "deck"@en,
        "deck slab"@en ;
    skos:definition "A slab component forming the bridge deck. Do not automatically identify it with the entire superstructure or the pavement layer."@en .

csbo:Diaphragm a owl:Class ;
    rdfs:label "Diaphragm"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "bulkhead"@en,
        "diaphragm"@en ;
    skos:definition "A transverse plate or assembly involved in maintaining section shape and transferring loads. Its location and openings are separate information."@en .

csbo:PrestressingAnchorage a owl:Class ;
    rdfs:label "Prestressing anchorage"@en ;
    rdfs:subClassOf csbo:AnchorageAssembly ;
    skos:altLabel "PT anchorage"@en,
        "tendon anchorage"@en ;
    skos:definition "A device anchoring a concrete prestressing tendon or bar. It is not a general synonym for a stay-cable anchorage."@en .

csbo:PrestressingBar a owl:Class ;
    rdfs:label "Prestressing bar"@en ;
    rdfs:subClassOf csbo:PrestressingTendon ;
    skos:altLabel "PT BAR"@en,
        "tensioning bar"@en ;
    skos:definition "A bar-type tensile element used for prestressing. Interpret the label PT BAR together with its installation context."@en .

csbo:SectionAssignment a owl:Class ;
    rdfs:label "Section assignment"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:definition "Information linking a section definition to applicable stations, zones, directions and states. Repeated depictions of the same section do not establish the number of physical occurrences."@en .

csbo:Stiffener a owl:Class ;
    rdfs:label "Stiffener"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "rib"@en,
        "stiffener"@en ;
    skos:definition "A reinforcing component providing local stiffness to a plate or girder. Distinguish it from the entire stiffening girder."@en .

csbo:StiffeningGirder a owl:Class ;
    rdfs:label "Stiffening girder"@en ;
    rdfs:subClassOf csbo:Girder ;
    skos:altLabel "stiffening beam"@en,
        "stiffening girder"@en ;
    skos:definition "A girder providing stiffness to the superstructure of a cable-stayed bridge. Whether it is a steel box girder is separate type information."@en .

csbo:AnchorageBearingPlate a owl:Class ;
    rdfs:label "Anchorage bearing plate"@en ;
    rdfs:subClassOf csbo:SteelPlate ;
    skos:altLabel "anchor plate"@en,
        "anchorage plate"@en,
        "bearing plate"@en ;
    skos:definition "A plate component used to transfer and distribute anchorage force. Do not classify it as a bridge bearing solely from the words Bearing Plate."@en .

csbo:ComponentType a owl:Class ;
    rdfs:label "Component type definition"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:altLabel "component-type specification"@en ;
    skos:definition "An information entity describing a detail type or specification shared by multiple installed instances. Distinguish it from an OWL class itself and from an individual installed component. Verify the role of a heading such as CA48 from the drawings."@en .

csbo:AnchorageTube a owl:Class ;
    rdfs:label "Anchorage tube"@en ;
    rdfs:subClassOf csbo:PhysicalComponent ;
    skos:altLabel "anchorage tube"@en,
        "anchoring tube"@en ;
    skos:definition "A tube allowing passage or guidance of a cable near an anchorage. Distinguish it from the entire anchorage or protective sheath; determine its precise function from the drawings."@en .

csbo:CrossSectionDefinition a owl:Class ;
    rdfs:label "Cross-section definition"@en ;
    rdfs:subClassOf csbo:GeometryDefinition ;
    skos:altLabel "section profile"@en,
        "standard cross-section"@en ;
    skos:definition "An information entity describing a section profile, openings and local coordinate system. Do not assume that one standard section applies throughout an entire span."@en .

csbo:ModelState a owl:Class ;
    rdfs:label "Model reference state"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:definition "A reference state for interpreting geometry and lengths, such as fabrication, erection, before or after stressing, or the completed structure. Values may vary by state."@en .

csbo:Pylon a owl:Class ;
    rdfs:label "Pylon"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "pylon"@en,
        "pylon assembly"@en ;
    skos:definition "The physical pylon assembly connected to stay cables or similar elements. Distinguish it from the spatial PylonZone."@en .

csbo:PrestressingTendon a owl:Class ;
    rdfs:label "Prestressing tendon"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "PT tendon"@en,
        "prestressing strand"@en,
        "tendon"@en ;
    skos:definition "A tendon introducing prestress into concrete. Its form, such as strand or bar, is separate information."@en .

csbo:StayCableAnchorage a owl:Class ;
    rdfs:label "Stay-cable anchorage"@en ;
    rdfs:subClassOf csbo:AnchorageAssembly ;
    skos:altLabel "stay-cable anchoring assembly"@en ;
    skos:definition "An assembly anchoring a stay cable. Distinguish it from the anchorage of a PT BAR used for local anchorage reinforcement."@en .

csbo:partOf a owl:ObjectProperty ;
    rdfs:label "is a physical part of"@en ;
    rdfs:domain csbo:PhysicalComponent ;
    rdfs:range csbo:AssetEntity ;
    skos:definition "Indicates that a component is a physical part of a component assembly or bridge asset. Do not use it for spatial containment or membership in a drawing file."@en .

csbo:AuxiliaryComponent a owl:Class ;
    rdfs:label "Auxiliary component"@en ;
    rdfs:subClassOf csbo:PhysicalComponent ;
    skos:definition "A component serving functions such as protection, inspection, drainage or serviceability. This classification is not unconditionally disjoint from structural components."@en .

csbo:DrawingMention a owl:Class ;
    rdfs:label "Drawing mention"@en ;
    rdfs:subClassOf csbo:EvidenceEntity ;
    skos:definition "One depiction in a drawing, such as text, a symbol, linework or a detail reference. A one-to-one relationship with a physical component instance is not guaranteed."@en .

csbo:DrawingView a owl:Class ;
    rdfs:label "Drawing view"@en ;
    rdfs:subClassOf csbo:EvidenceEntity ;
    skos:definition "An area showing a specific projection or detail, such as a plan, elevation, section or detail. Do not directly combine coordinates from different views."@en .

csbo:ReferencePointRole a owl:Class ;
    rdfs:label "Reference point role"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:definition "A role entity defining the physical location represented by a reference point. Do not determine coordinates from an abbreviation alone."@en .

csbo:AssetEntity a owl:Class ;
    rdfs:label "Asset entity"@en ;
    rdfs:subClassOf csbo:Entity ;
    skos:definition "An entity describing a physical bridge asset, its components or its spaces."@en .

csbo:Revision a owl:Class ;
    rdfs:label "Revision information"@en ;
    rdfs:subClassOf csbo:EvidenceEntity ;
    skos:definition "An entity describing a drawing revision number, date and changes. Distinguish revision-history text from evidence of a currently present component."@en .

csbo:EvidenceEntity a owl:Class ;
    rdfs:label "Evidence information entity"@en ;
    rdfs:subClassOf csbo:Entity ;
    skos:definition "An information entity describing evidence used to establish facts, such as drawings, annotations, revisions and sources."@en .

csbo:SourceReference a owl:Class ;
    rdfs:label "Source location reference"@en ;
    rdfs:subClassOf csbo:EvidenceEntity ;
    skos:definition "A record allowing evidence to be located again through the original file, page, layout, view, handle, region or similar identifier."@en .

csbo:StayCable a owl:Class ;
    rdfs:label "Stay cable"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "stay cable"@en,
        "stay-cable assembly"@en ;
    skos:definition "A cable assembly with a designed tensile support function between a pylon and a girder or the superstructure of a cable-stayed bridge. Distinguish it from PT tendons, tie-downs and electrical cables."@en .

csbo:AnchorageAssembly a owl:Class ;
    rdfs:label "Anchorage assembly"@en ;
    rdfs:subClassOf csbo:StructuralComponent ;
    skos:altLabel "anchorage"@en,
        "anchorage-region assembly"@en ;
    skos:definition "An assembly of anchorage parts transferring force from a tensile element into its supporting structure. Distinguish subtypes by their roles."@en .

csbo:CablePath a owl:Class ;
    rdfs:label "Cable path"@en ;
    rdfs:subClassOf csbo:GeometryDefinition ;
    skos:definition "A geometric representation of a cable reference line or centerline. Interpret it with its reference points, length definition and state."@en .

csbo:CoordinateFrame a owl:Class ;
    rdfs:label "Coordinate frame"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:altLabel "global coordinate system"@en,
        "local coordinate system"@en ;
    skos:definition "A reference frame describing its origin, axis directions, length unit and transformations to other coordinate frames."@en .

csbo:DrawingFile a owl:Class ;
    rdfs:label "Drawing file"@en ;
    rdfs:subClassOf csbo:EvidenceEntity ;
    skos:definition "An original or derived document at file level, such as DWG, DXF or PDF. Manage copied paths together with original content identifiers."@en .

csbo:ReferencePoint a owl:Class ;
    rdfs:label "Reference point"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:definition "A point with assigned coordinates and a role. Distinguish points with different meanings, such as an anchorage plate center and a tube endpoint."@en .

csbo:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    skos:definition "The top-level concept identifying assets, components, spaces, information and model representations. A physical component and its depiction in a drawing are different entities."@en .

csbo:SpatialZone a owl:Class ;
    rdfs:label "Spatial zone"@en ;
    rdfs:subClassOf csbo:AssetEntity ;
    skos:altLabel "zone"@en ;
    skos:definition "A spatial concept subdividing a bridge by location or segment. Distinguish it from an assembly of physical components."@en .

csbo:ParameterAssignment a owl:Class ;
    rdfs:label "Parameter value assignment"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:definition "A record linking one parameter to a value, unit, status and source. An unresolved record without a number is also permitted."@en .

csbo:GeometryDefinition a owl:Class ;
    rdfs:label "Geometry definition"@en ;
    rdfs:subClassOf csbo:ModelingEntity ;
    skos:definition "A representation such as a path, section or solid used for shape generation. It is not the physical component itself."@en .

csbo:ModelingEntity a owl:Class ;
    rdfs:label "Modeling information entity"@en ;
    rdfs:subClassOf csbo:Entity ;
    skos:definition "An information entity representing geometry, coordinates, parameters or mechanics. Distinguish it from a physical component."@en .

csbo:ruleAction a owl:AnnotationProperty .

csbo:ruleCondition a owl:AnnotationProperty .

csbo:PhysicalComponent a owl:Class ;
    rdfs:label "Physical component"@en ;
    rdfs:subClassOf csbo:AssetEntity ;
    owl:disjointWith csbo:EvidenceEntity,
        csbo:ModelingEntity,
        csbo:SpatialZone ;
    skos:definition "A component or assembly that physically exists or is intended in the design. Distinguish it from lines, text and views depicting that component."@en .

csbo:StructuralComponent a owl:Class ;
    rdfs:label "Structural component"@en ;
    rdfs:subClassOf csbo:PhysicalComponent ;
    skos:definition "A component or assembly with a structural function in the project. Structural function alone does not determine its section, material or connection conditions."@en .

skos:altLabel a owl:AnnotationProperty .

csbo:GenerationRule a owl:Class ;
    rdfs:label "Generation knowledge rule"@en ;
    rdfs:subClassOf csbo:Entity ;
    skos:definition "A model-generation instruction specifying a condition and an action. In this version it is not a constraint executed by an OWL reasoner or an automatic grader."@en .

skos:definition a owl:AnnotationProperty .

csbo:relatedConcept a owl:AnnotationProperty .

