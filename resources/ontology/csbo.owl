  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b826">
    <csbo:factId>F0826</csbo:factId>
    <owl:annotatedTarget xml:lang="en">When reading headings or type numbers such as CA48 or TYPE-A1</owl:annotatedTarget>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:evidenceBasis>LOCAL</csbo:evidenceBasis>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R31">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PhysicalComponent"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#ComponentType"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CrossSectionDefinition"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#hasComponentType"/>
        <csbo:ruleCondition xml:lang="en">When reading headings or type numbers such as CA48 or TYPE-A1</csbo:ruleCondition>
        <csbo:ruleAction xml:lang="en">Determine whether the role is a ComponentType definition, CrossSectionDefinition, individual installed PhysicalComponent or SpatialZone. Do not treat one heading as a unique actual cable or anchorage. Actual installed instances of the same type have different identifiers.</csbo:ruleAction>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <csbo:scope xml:lang="en">Types and instances</csbo:scope>
    <owl:annotatedProperty>
      <owl:AnnotationProperty rdf:about="https://example.org/csbo#ruleCondition"/>
    </owl:annotatedProperty>
  </owl:Axiom>
