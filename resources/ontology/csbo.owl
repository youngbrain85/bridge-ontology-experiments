  <owl:Class rdf:about="https://example.org/csbo#Abutment">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:altLabel xml:lang="en">abutment</skos:altLabel>
    <rdfs:label xml:lang="en">Abutment</rdfs:label>
    <skos:definition xml:lang="en">A physical component or assembly forming the support structure at a bridge end.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PylonCrossbeam">
    <skos:definition xml:lang="en">A crossbeam connecting pylon legs or similar parts. Do not assume that every pylon has one.</skos:definition>
    <rdfs:label xml:lang="en">Pylon crossbeam</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:altLabel xml:lang="en">pylon transverse beam</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Pylon">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:definition xml:lang="en">The physical pylon assembly connected to stay cables or similar elements. Distinguish it from the spatial PylonZone.</skos:definition>
    <rdfs:label xml:lang="en">Pylon</rdfs:label>
    <skos:altLabel xml:lang="en">pylon</skos:altLabel>
    <skos:altLabel xml:lang="en">pylon assembly</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PrestressingAnchorage">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AnchorageAssembly"/>
    <skos:altLabel xml:lang="en">PT anchorage</skos:altLabel>
    <skos:altLabel xml:lang="en">tendon anchorage</skos:altLabel>
    <rdfs:label xml:lang="en">Prestressing anchorage</rdfs:label>
    <skos:definition xml:lang="en">A device anchoring a concrete prestressing tendon or bar. It is not a general synonym for a stay-cable anchorage.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#DeckAssembly">
    <rdfs:label xml:lang="en">Deck assembly</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:definition xml:lang="en">A physical assembly grouping the deck and related components. Distinguish it from an individual slab.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PylonLeg">
    <skos:altLabel xml:lang="en">tower leg</skos:altLabel>
    <skos:definition xml:lang="en">A column or tower-leg component forming a pylon. Determine its section, inclination and segmentation from the drawings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <rdfs:label xml:lang="en">Pylon leg</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#DrawingSheet">
    <rdfs:label xml:lang="en">Drawing sheet</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#EvidenceEntity"/>
    <skos:definition xml:lang="en">A source unit within a file, such as a printed sheet, layout or PDF page. One file may contain multiple sheets.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CrossSectionDefinition">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#GeometryDefinition"/>
    <skos:definition xml:lang="en">An information entity describing a section profile, openings and local coordinate system. Do not assume that one standard section applies throughout an entire span.</skos:definition>
    <skos:altLabel xml:lang="en">standard cross-section</skos:altLabel>
    <skos:altLabel xml:lang="en">section profile</skos:altLabel>
    <rdfs:label xml:lang="en">Cross-section definition</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#DrainageComponent">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AuxiliaryComponent"/>
    <rdfs:label xml:lang="en">Drainage component</rdfs:label>
    <skos:altLabel xml:lang="en">drainage pipe</skos:altLabel>
    <skos:altLabel xml:lang="en">drainage inlet</skos:altLabel>
    <skos:definition xml:lang="en">A component serving drainage functions, such as a drainage pipe or inlet.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#LoftGeometry">
    <rdfs:label xml:lang="en">Loft geometry definition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#GeometryDefinition"/>
    <skos:definition xml:lang="en">A representation creating a shape by connecting sections at multiple positions. Distinguish section positions, order, profile correspondence and transition method.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#GenerationRule">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#Entity"/>
    <rdfs:label xml:lang="en">Generation knowledge rule</rdfs:label>
    <skos:definition xml:lang="en">A model-generation instruction specifying a condition and an action. In this version it is not a constraint executed by an OWL reasoner or an automatic grader.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ExpansionJoint">
    <skos:altLabel xml:lang="en">expansion joint device</skos:altLabel>
    <rdfs:label xml:lang="en">Expansion joint</rdfs:label>
    <skos:definition xml:lang="en">A joint device accommodating designed structural displacement. Distinguish it from a simple line depicting a joint.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#PhysicalComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Pier">
    <skos:definition xml:lang="en">A physical pier component or assembly supporting the superstructure or similar elements. Distinguish it from a spatial zone identifying the pier location.</skos:definition>
    <skos:altLabel xml:lang="en">pier</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <rdfs:label xml:lang="en">Pier</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#SteelBoxGirder">
    <skos:definition xml:lang="en">A stiffening girder with a box section formed from steel plates or similar elements. Internal diaphragms and stiffeners may be represented as separate components.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StiffeningGirder"/>
    <rdfs:label xml:lang="en">Steel box stiffening girder</rdfs:label>
    <skos:altLabel xml:lang="en">steel box girder</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CableStayedBridge">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#Bridge"/>
    <skos:altLabel xml:lang="en">cable-stayed bridge</skos:altLabel>
    <skos:definition xml:lang="en">A bridge in which stay cables form structural support relationships between pylons and girders or the superstructure. Pylon shape and cable arrangement are project-specific information.</skos:definition>
    <rdfs:label xml:lang="en">Cable-stayed bridge</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Pile">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:definition xml:lang="en">A pile component forming part of a foundation. Verify pile count, diameter, inclination and length from the drawings.</skos:definition>
    <rdfs:label xml:lang="en">Pile</rdfs:label>
    <skos:altLabel xml:lang="en">pile</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#SpatialZone">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AssetEntity"/>
    <skos:definition xml:lang="en">A spatial concept subdividing a bridge by location or segment. Distinguish it from an assembly of physical components.</skos:definition>
    <rdfs:label xml:lang="en">Spatial zone</rdfs:label>
    <skos:altLabel xml:lang="en">zone</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PylonZone">
    <skos:definition xml:lang="en">A spatial subdivision containing a pylon and related components. It is not the physical pylon assembly itself.</skos:definition>
    <rdfs:label xml:lang="en">Pylon zone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#SpatialZone"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#AnchorageZone">
    <skos:definition xml:lang="en">A spatial subdivision containing an anchorage and local reinforcing components. This does not mean that every component within it belongs to the same anchorage assembly.</skos:definition>
    <rdfs:label xml:lang="en">Anchorage zone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#SpatialZone"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#AnchorageAssembly">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <rdfs:label xml:lang="en">Anchorage assembly</rdfs:label>
    <skos:altLabel xml:lang="en">anchorage</skos:altLabel>
    <skos:altLabel xml:lang="en">anchorage-region assembly</skos:altLabel>
    <skos:definition xml:lang="en">An assembly of anchorage parts transferring force from a tensile element into its supporting structure. Distinguish subtypes by their roles.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PrecastDeckPanel">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#DeckSlab"/>
    <skos:definition xml:lang="en">An individual deck panel manufactured before installation. Distinguish it from cast-in-place joints.</skos:definition>
    <skos:altLabel xml:lang="en">PC panel</skos:altLabel>
    <skos:altLabel xml:lang="en">precast panel</skos:altLabel>
    <rdfs:label xml:lang="en">Precast deck panel</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ComponentType">
    <skos:altLabel xml:lang="en">component-type specification</skos:altLabel>
    <skos:definition xml:lang="en">An information entity describing a detail type or specification shared by multiple installed instances. Distinguish it from an OWL class itself and from an individual installed component. Verify the role of a heading such as CA48 from the drawings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
    <rdfs:label xml:lang="en">Component type definition</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#TieDownAnchorage">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AnchorageAssembly"/>
    <skos:definition xml:lang="en">An assembly anchoring a tie-down tensile element to its supporting structure. Distinguish its role from a stay-cable anchorage.</skos:definition>
    <rdfs:label xml:lang="en">Tie-down anchorage</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Bridge">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AssetEntity"/>
    <owl:disjointWith rdf:resource="https://example.org/csbo#PhysicalComponent"/>
    <skos:altLabel xml:lang="en">bridge structure</skos:altLabel>
    <skos:definition xml:lang="en">One bridge asset, connected to its spans, components, zones and drawing set.</skos:definition>
    <rdfs:label xml:lang="en">Bridge</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ElectricalCable">
    <skos:altLabel xml:lang="en">communication cable</skos:altLabel>
    <skos:altLabel xml:lang="en">power cable</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AuxiliaryComponent"/>
    <rdfs:label xml:lang="en">Electrical or communication cable</rdfs:label>
    <skos:definition xml:lang="en">A cable transmitting power, communication or data. Distinguish it from stay cables and tie-down cables.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Foundation">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:definition xml:lang="en">A foundation assembly transferring loads from above to the ground or other supporting medium. Its type, such as piled or spread foundation, is project-specific information.</skos:definition>
    <rdfs:label xml:lang="en">Foundation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Girder">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:definition xml:lang="en">A beam or girder transmitting loads longitudinally or in another designed direction within the superstructure.</skos:definition>
    <skos:altLabel xml:lang="en">girder</skos:altLabel>
    <rdfs:label xml:lang="en">Girder</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#DrawingView">
    <skos:definition xml:lang="en">An area showing a specific projection or detail, such as a plan, elevation, section or detail. Do not directly combine coordinates from different views.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#EvidenceEntity"/>
    <rdfs:label xml:lang="en">Drawing view</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Diaphragm">
    <skos:altLabel xml:lang="en">bulkhead</skos:altLabel>
    <skos:altLabel xml:lang="en">diaphragm</skos:altLabel>
    <skos:definition xml:lang="en">A transverse plate or assembly involved in maintaining section shape and transferring loads. Its location and openings are separate information.</skos:definition>
    <rdfs:label xml:lang="en">Diaphragm</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#AnchorageTube">
    <skos:altLabel xml:lang="en">anchorage tube</skos:altLabel>
    <skos:altLabel xml:lang="en">anchoring tube</skos:altLabel>
    <skos:definition xml:lang="en">A tube allowing passage or guidance of a cable near an anchorage. Distinguish it from the entire anchorage or protective sheath; determine its precise function from the drawings.</skos:definition>
    <rdfs:label xml:lang="en">Anchorage tube</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#PhysicalComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#StructuralComponent">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#PhysicalComponent"/>
    <skos:definition xml:lang="en">A component or assembly with a structural function in the project. Structural function alone does not determine its section, material or connection conditions.</skos:definition>
    <rdfs:label xml:lang="en">Structural component</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#AuxiliaryComponent">
    <rdfs:label xml:lang="en">Auxiliary component</rdfs:label>
    <skos:definition xml:lang="en">A component serving functions such as protection, inspection, drainage or serviceability. This classification is not unconditionally disjoint from structural components.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#PhysicalComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ShearConnector">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <rdfs:label xml:lang="en">Shear connector</rdfs:label>
    <skos:altLabel xml:lang="en">stud</skos:altLabel>
    <skos:altLabel xml:lang="en">shear connector</skos:altLabel>
    <skos:definition xml:lang="en">A connecting component transferring shear between different components. Stud counts and arrangements require separate evidence.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#DeckZone">
    <rdfs:label xml:lang="en">Superstructure zone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#SpatialZone"/>
    <skos:definition xml:lang="en">A space subdividing the superstructure into panels, segments, construction zones or similar divisions. Record the subdivision criteria.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#StayCableAnchorage">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AnchorageAssembly"/>
    <rdfs:label xml:lang="en">Stay-cable anchorage</rdfs:label>
    <skos:definition xml:lang="en">An assembly anchoring a stay cable. Distinguish it from the anchorage of a PT BAR used for local anchorage reinforcement.</skos:definition>
    <skos:altLabel xml:lang="en">stay-cable anchoring assembly</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#AnchorageBearingPlate">
    <skos:altLabel xml:lang="en">anchorage plate</skos:altLabel>
    <skos:altLabel xml:lang="en">bearing plate</skos:altLabel>
    <skos:altLabel xml:lang="en">anchor plate</skos:altLabel>
    <skos:definition xml:lang="en">A plate component used to transfer and distribute anchorage force. Do not classify it as a bridge bearing solely from the words Bearing Plate.</skos:definition>
    <rdfs:label xml:lang="en">Anchorage bearing plate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#SteelPlate"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#DrawingMention">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#EvidenceEntity"/>
    <rdfs:label xml:lang="en">Drawing mention</rdfs:label>
    <skos:definition xml:lang="en">One depiction in a drawing, such as text, a symbol, linework or a detail reference. A one-to-one relationship with a physical component instance is not guaranteed.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PrestressingBar">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#PrestressingTendon"/>
    <skos:altLabel xml:lang="en">tensioning bar</skos:altLabel>
    <skos:altLabel xml:lang="en">PT BAR</skos:altLabel>
    <skos:definition xml:lang="en">A bar-type tensile element used for prestressing. Interpret the label PT BAR together with its installation context.</skos:definition>
    <rdfs:label xml:lang="en">Prestressing bar</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CastInPlaceDeckPart">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#DeckSlab"/>
    <skos:altLabel xml:lang="en">cast-in-place portion</skos:altLabel>
    <rdfs:label xml:lang="en">Cast-in-place deck part</rdfs:label>
    <skos:definition xml:lang="en">A deck portion cast on site or a cast-in-place zone between panels. Identify it by the project's subdivision boundaries.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#TransverseBeam">
    <skos:definition xml:lang="en">A beam arranged transversely in the superstructure. Distinguish it from a pylon crossbeam and verify connected components from the drawings.</skos:definition>
    <skos:altLabel xml:lang="en">cross beam</skos:altLabel>
    <skos:altLabel xml:lang="en">crossbeam</skos:altLabel>
    <rdfs:label xml:lang="en">Superstructure transverse beam</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#SectionAssignment">
    <skos:definition xml:lang="en">Information linking a section definition to applicable stations, zones, directions and states. Repeated depictions of the same section do not establish the number of physical occurrences.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
    <rdfs:label xml:lang="en">Section assignment</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CableSaddle">
    <rdfs:label xml:lang="en">Cable saddle</rdfs:label>
    <skos:altLabel xml:lang="en">cable guide saddle</skos:altLabel>
    <skos:altLabel xml:lang="en">saddle</skos:altLabel>
    <skos:definition xml:lang="en">A saddle component supporting and guiding the path of a continuous cable or similar element. Represent it when confirmed in the drawings; do not automatically equate it with an end anchorage.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Stiffener">
    <rdfs:label xml:lang="en">Stiffener</rdfs:label>
    <skos:definition xml:lang="en">A reinforcing component providing local stiffness to a plate or girder. Distinguish it from the entire stiffening girder.</skos:definition>
    <skos:altLabel xml:lang="en">rib</skos:altLabel>
    <skos:altLabel xml:lang="en">stiffener</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CurvedCablePath">
    <rdfs:label xml:lang="en">Curved cable path</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#CablePath"/>
    <skos:definition xml:lang="en">A cable path representing sag, curvature or similar features. Specify curve equations and control points only when supported by evidence.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#TieDownCable">
    <skos:altLabel xml:lang="en">tie-down</skos:altLabel>
    <skos:altLabel xml:lang="en">tie-down cable</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <rdfs:label xml:lang="en">Tie-down cable</rdfs:label>
    <skos:definition xml:lang="en">A tensile tie-down cable providing restraint, for example against uplift. Do not automatically classify it as a stay cable.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ModelingEntity">
    <rdfs:label xml:lang="en">Modeling information entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#Entity"/>
    <skos:definition xml:lang="en">An information entity representing geometry, coordinates, parameters or mechanics. Distinguish it from a physical component.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ModelState">
    <skos:definition xml:lang="en">A reference state for interpreting geometry and lengths, such as fabrication, erection, before or after stressing, or the completed structure. Values may vary by state.</skos:definition>
    <rdfs:label xml:lang="en">Model reference state</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#SpanZone">
    <skos:definition xml:lang="en">A spatial span zone bounded by project-defined criteria, such as adjacent support locations. Span length is separate project information.</skos:definition>
    <rdfs:label xml:lang="en">Span zone</rdfs:label>
    <skos:altLabel xml:lang="en">span</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#SpatialZone"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#StayCable">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:definition xml:lang="en">A cable assembly with a designed tensile support function between a pylon and a girder or the superstructure of a cable-stayed bridge. Distinguish it from PT tendons, tie-downs and electrical cables.</skos:definition>
    <rdfs:label xml:lang="en">Stay cable</rdfs:label>
    <skos:altLabel xml:lang="en">stay-cable assembly</skos:altLabel>
    <skos:altLabel xml:lang="en">stay cable</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#SteelPlate">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:definition xml:lang="en">A plate-shaped steel component. Its meaning, such as anchorage plate or web plate, depends on its role and installation location.</skos:definition>
    <skos:altLabel xml:lang="en">plate</skos:altLabel>
    <rdfs:label xml:lang="en">Steel plate</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CableDamper">
    <rdfs:label xml:lang="en">Cable damper</rdfs:label>
    <skos:definition xml:lang="en">A component for cable vibration control. Model it when its presence and installation point are confirmed in the drawings.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AuxiliaryComponent"/>
    <skos:altLabel xml:lang="en">damper</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#DeckSlab">
    <skos:altLabel xml:lang="en">deck</skos:altLabel>
    <skos:altLabel xml:lang="en">deck slab</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:definition xml:lang="en">A slab component forming the bridge deck. Do not automatically identify it with the entire superstructure or the pavement layer.</skos:definition>
    <rdfs:label xml:lang="en">Deck slab</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PrestressingTendon">
    <skos:definition xml:lang="en">A tendon introducing prestress into concrete. Its form, such as strand or bar, is separate information.</skos:definition>
    <skos:altLabel xml:lang="en">prestressing strand</skos:altLabel>
    <skos:altLabel xml:lang="en">tendon</skos:altLabel>
    <skos:altLabel xml:lang="en">PT tendon</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <rdfs:label xml:lang="en">Prestressing tendon</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ConnectionSpecification">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
    <skos:definition xml:lang="en">A specification describing contact, fastening, support, anchorage and mechanical restraint conditions separately. A simple connection relationship does not imply a rigid connection.</skos:definition>
    <rdfs:label xml:lang="en">Connection specification</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PierZone">
    <rdfs:label xml:lang="en">Pier zone</rdfs:label>
    <skos:definition xml:lang="en">A spatial zone corresponding to an evidenced pier-location identifier such as P9 or P10. It is a separate entity from the physical pier.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#SpatialZone"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Railing">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AuxiliaryComponent"/>
    <skos:altLabel xml:lang="en">railing</skos:altLabel>
    <skos:altLabel xml:lang="en">safety barrier</skos:altLabel>
    <rdfs:label xml:lang="en">Railing or protective barrier component</rdfs:label>
    <skos:definition xml:lang="en">A railing, parapet or safety barrier component at a deck edge or similar location. Record its detailed type as a separate property.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#DrawingFile">
    <rdfs:label xml:lang="en">Drawing file</rdfs:label>
    <skos:definition xml:lang="en">An original or derived document at file level, such as DWG, DXF or PDF. Manage copied paths together with original content identifiers.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#EvidenceEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#StraightCablePath">
    <skos:definition xml:lang="en">A cable geometry representation declared as one straight segment. Selecting this type does not mean that all stay cables are straight.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#CablePath"/>
    <rdfs:label xml:lang="en">Straight cable path</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CablePath">
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#GeometryDefinition"/>
    <rdfs:label xml:lang="en">Cable path</rdfs:label>
    <skos:definition xml:lang="en">A geometric representation of a cable reference line or centerline. Interpret it with its reference points, length definition and state.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#WindRestraint">
    <rdfs:label xml:lang="en">Wind restraint</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <skos:altLabel xml:lang="en">wind restraint device</skos:altLabel>
    <skos:definition xml:lang="en">A support or restraint device responding to wind loads or similar actions in designed directions. Distinguish it from bridge bearings and tie-downs by its actual function and assembly relationships.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#EvidenceEntity">
    <rdfs:label xml:lang="en">Evidence information entity</rdfs:label>
    <skos:definition xml:lang="en">An information entity describing evidence used to establish facts, such as drawings, annotations, revisions and sources.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#StiffeningGirder">
    <skos:altLabel xml:lang="en">stiffening beam</skos:altLabel>
    <skos:altLabel xml:lang="en">stiffening girder</skos:altLabel>
    <skos:definition xml:lang="en">A girder providing stiffness to the superstructure of a cable-stayed bridge. Whether it is a steel box girder is separate type information.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#Girder"/>
    <rdfs:label xml:lang="en">Stiffening girder</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ReferencePoint">
    <rdfs:label xml:lang="en">Reference point</rdfs:label>
    <skos:definition xml:lang="en">A point with assigned coordinates and a role. Distinguish points with different meanings, such as an anchorage plate center and a tube endpoint.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#MaterialSpecification">
    <skos:definition xml:lang="en">A specification of material type, grade or similar attributes. Do not determine steel grade, concrete strength or similar values from a component name alone.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
    <rdfs:label xml:lang="en">Material specification</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PlateGeometry">
    <rdfs:label xml:lang="en">Plate geometry definition</rdfs:label>
    <skos:definition xml:lang="en">A plate-generation representation using a section or planar profile, thickness, orientation and openings. Do not automatically copy dimensions from another plate.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#GeometryDefinition"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#PhysicalComponent">
    <rdfs:label xml:lang="en">Physical component</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AssetEntity"/>
    <owl:disjointWith rdf:resource="https://example.org/csbo#EvidenceEntity"/>
    <owl:disjointWith rdf:resource="https://example.org/csbo#ModelingEntity"/>
    <owl:disjointWith rdf:resource="https://example.org/csbo#SpatialZone"/>
    <skos:definition xml:lang="en">A component or assembly that physically exists or is intended in the design. Distinguish it from lines, text and views depicting that component.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#GeometryDefinition">
    <skos:definition xml:lang="en">A representation such as a path, section or solid used for shape generation. It is not the physical component itself.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
    <rdfs:label xml:lang="en">Geometry definition</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Revision">
    <rdfs:label xml:lang="en">Revision information</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#EvidenceEntity"/>
    <skos:definition xml:lang="en">An entity describing a drawing revision number, date and changes. Distinguish revision-history text from evidence of a currently present component.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ReferencePointRole">
    <rdfs:label xml:lang="en">Reference point role</rdfs:label>
    <skos:definition xml:lang="en">A role entity defining the physical location represented by a reference point. Do not determine coordinates from an abbreviation alone.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ParameterAssignment">
    <rdfs:label xml:lang="en">Parameter value assignment</rdfs:label>
    <skos:definition xml:lang="en">A record linking one parameter to a value, unit, status and source. An unresolved record without a number is also permitted.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#SourceReference">
    <skos:definition xml:lang="en">A record allowing evidence to be located again through the original file, page, layout, view, handle, region or similar identifier.</skos:definition>
    <rdfs:label xml:lang="en">Source location reference</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#EvidenceEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Bearing">
    <skos:altLabel xml:lang="en">bridge bearing</skos:altLabel>
    <skos:altLabel xml:lang="en">bearing</skos:altLabel>
    <skos:definition xml:lang="en">A device between the superstructure and supporting substructure that transfers loads and accommodates designed movement or rotation. Distinguish it from an anchorage bearing plate.</skos:definition>
    <rdfs:label xml:lang="en">Bridge bearing</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CoordinateFrame">
    <skos:definition xml:lang="en">A reference frame describing its origin, axis directions, length unit and transformations to other coordinate frames.</skos:definition>
    <skos:altLabel xml:lang="en">local coordinate system</skos:altLabel>
    <skos:altLabel xml:lang="en">global coordinate system</skos:altLabel>
    <rdfs:label xml:lang="en">Coordinate frame</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#ModelingEntity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CableSheath">
    <skos:altLabel xml:lang="en">protective covering</skos:altLabel>
    <skos:altLabel xml:lang="en">HDPE pipe</skos:altLabel>
    <rdfs:label xml:lang="en">Cable sheath</rdfs:label>
    <skos:definition xml:lang="en">A tube or covering protecting a stay cable or similar element. Do not confuse its outside diameter with that of the internal tensile element.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#AuxiliaryComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#ReinforcementBar">
    <skos:definition xml:lang="en">A reinforcing bar used in concrete. Distinguish a rebar mark from a pier or zone identifier.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <rdfs:label xml:lang="en">Reinforcing bar</rdfs:label>
    <skos:altLabel xml:lang="en">rebar</skos:altLabel>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#Entity">
    <skos:definition xml:lang="en">The top-level concept identifying assets, components, spaces, information and model representations. A physical component and its depiction in a drawing are different entities.</skos:definition>
    <rdfs:label xml:lang="en">Entity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#CableSegment">
    <skos:definition xml:lang="en">A portion of an actual cable identified in a segmented model. It is not the same concept as a geometric line segment.</skos:definition>
    <rdfs:label xml:lang="en">Physical cable segment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#StructuralComponent"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#SweepGeometry">
    <skos:definition xml:lang="en">A generation representation moving a section along a reference path. It requires the path, section, section orientation and application range; algorithm syntax is defined by a separate generator.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#GeometryDefinition"/>
    <rdfs:label xml:lang="en">Sweep geometry definition</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#AssetEntity">
    <skos:definition xml:lang="en">An entity describing a physical bridge asset, its components or its spaces.</skos:definition>
    <rdfs:label xml:lang="en">Asset entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/csbo#TubeGeometry">
    <rdfs:label xml:lang="en">Tube geometry definition</rdfs:label>
    <skos:definition xml:lang="en">A tube-generation representation using a path and outer and inner sections. Preserve unknown outside diameter, inside diameter or thickness values as unresolved.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/csbo#GeometryDefinition"/>
  </owl:Class>
</rdf:RDF>
