  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b871">
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#pointRole"/>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:evidenceBasis>LOCAL</csbo:evidenceBasis>
    <csbo:scope xml:lang="en">Reference-point ownership</csbo:scope>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R37">
        <csbo:ruleCondition xml:lang="en">When reference points with the same role occur at multiple locations</csbo:ruleCondition>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#referencePointOf"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#ReferencePoint"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#pointRole"/>
        <csbo:ruleAction xml:lang="en">Use pointRole together with referencePointOf to record which reference point belongs to which component. For example, the role of anchorage plate center alone does not justify merging pylon-side and girder-side reference points into one entity.</csbo:ruleAction>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <csbo:factId>F0871</csbo:factId>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b647">
    <csbo:factId>F0647</csbo:factId>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R02">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#ElectricalCable"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PrestressingBar"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#TieDownCable"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StayCable"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PrestressingTendon"/>
        <csbo:ruleAction xml:lang="en">Distinguish stay cables, prestressing tendons, prestressing bars, tie-downs and electrical or communication cables by their load-transfer roles and installation context. Do not create all of them as StayCable solely from part of an annotation.</csbo:ruleAction>
        <csbo:ruleCondition xml:lang="en">When annotations mention cables, strands, bars or anchorages</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <csbo:evidenceBasis>LOCAL</csbo:evidenceBasis>
    <csbo:evidenceBasis>IFC</csbo:evidenceBasis>
    <csbo:scope xml:lang="en">Classification</csbo:scope>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#StayCable"/>
  </owl:Axiom>
