  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b559">
    <csbo:factId>F0559</csbo:factId>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#Revision"/>
    <owl:annotatedSource>
      <owl:ObjectProperty rdf:about="https://example.org/csbo#hasRevision">
        <rdfs:range rdf:resource="https://example.org/csbo#Revision"/>
        <rdfs:label xml:lang="en">has revision information</rdfs:label>
        <rdfs:domain rdf:resource="https://example.org/csbo#DrawingFile"/>
        <skos:definition xml:lang="en">Links a file to its revision information.</skos:definition>
