  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b419">
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:factId>F0419</csbo:factId>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#StructuralComponent"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
    <owl:annotatedSource>
      <owl:ObjectProperty rdf:about="https://example.org/csbo#anchoredAt">
        <rdfs:label xml:lang="en">is anchored at an anchorage</rdfs:label>
        <rdfs:range rdf:resource="https://example.org/csbo#AnchorageAssembly"/>
        <skos:definition xml:lang="en">A relationship anchoring a tensile component to an anchorage assembly. Do not assert it solely from proximity or intersecting lines.</skos:definition>
        <rdfs:domain rdf:resource="https://example.org/csbo#StructuralComponent"/>
      </owl:ObjectProperty>
    </owl:annotatedSource>
    <csbo:scope xml:lang="en">Domain definition</csbo:scope>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b613">
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
    <csbo:scope xml:lang="en">Domain definition</csbo:scope>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#DrawingFile"/>
    <owl:annotatedSource>
      <owl:DatatypeProperty rdf:about="https://example.org/csbo#sha256">
        <rdfs:domain rdf:resource="https://example.org/csbo#DrawingFile"/>
        <rdfs:label xml:lang="en">Content hash</rdfs:label>
        <skos:definition xml:lang="en">The SHA-256 of the original bytes. It tracks duplicate files and does not establish identity of component instances.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:DatatypeProperty>
    </owl:annotatedSource>
    <csbo:factId>F0613</csbo:factId>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
  </owl:Axiom>
