  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b746">
    <csbo:factId>F0746</csbo:factId>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#ruleCondition"/>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R18">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#Pylon"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#Pier"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#Girder"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#supports"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#hasConnectionSpecification"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#Bearing"/>
        <csbo:ruleAction xml:lang="en">Distinguish structural support from rotation, movement and restraint conditions. Connection relationships do not propagate transitively to other components; do not convert them to fixed or hinged conditions without evidence.</csbo:ruleAction>
        <csbo:ruleCondition xml:lang="en">When connecting pylons, girders, bearings and piers</csbo:ruleCondition>
      </csbo:GenerationRule>
