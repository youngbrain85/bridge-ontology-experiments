  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b794">
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
    <owl:annotatedTarget>
      <owl:ObjectProperty rdf:about="https://example.org/csbo#hasEvidence">
        <skos:definition xml:lang="en">Links a concept instance, value or relationship assertion to its evidence location. A domain definition does not replace direct evidence for a dimension in a specific drawing.</skos:definition>
        <rdfs:range rdf:resource="https://example.org/csbo#SourceReference"/>
        <rdfs:label xml:lang="en">has a source location reference</rdfs:label>
        <rdfs:domain rdf:resource="https://example.org/csbo#Entity"/>
      </owl:ObjectProperty>
    </owl:annotatedTarget>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:factId>F0794</csbo:factId>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R25">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#ParameterAssignment"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#SourceReference"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#hasEvidence"/>
        <csbo:ruleAction xml:lang="en">Distinguish directly read information from inference and record sources such as file, sheet, view, detail and handle. Do not use ontology definitions as evidence proving numeric values or connection facts for this bridge.</csbo:ruleAction>
        <csbo:ruleCondition xml:lang="en">When determining component dimensions, materials, coordinates or relationships</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <csbo:scope xml:lang="en">Value provenance</csbo:scope>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b830">
