    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:factId>F0698</csbo:factId>
    <csbo:scope xml:lang="en">Coordinates</csbo:scope>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R10">
        <csbo:ruleCondition xml:lang="en">When combining plan, elevation, section, detail or block coordinates</csbo:ruleCondition>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#parentFrame"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CoordinateFrame"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#DrawingView"/>
        <csbo:ruleAction xml:lang="en">First verify each view's and block's coordinate system, projection, axes, scale, rotation and insertion transform. CAD text extraction text.position is a text placement point, not a physical-object coordinate. Do not directly use block-local coordinates as global bridge coordinates either.</csbo:ruleAction>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedTarget xml:lang="en">When combining plan, elevation, section, detail or block coordinates</owl:annotatedTarget>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#ruleCondition"/>
  </owl:Axiom>
