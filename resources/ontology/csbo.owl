    <owl:annotatedSource rdf:resource="https://example.org/csbo#R11"/>
    <owl:annotatedTarget xml:lang="en">Check dimension annotations, unit labels, coordinate tables and consistent reference dimensions. Do not determine physical dimension units solely from CAD file unit metadata or output image size. Preserve conflicting values and their sources and leave them unresolved.</owl:annotatedTarget>
