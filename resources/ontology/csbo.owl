  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b880">
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#SourceReference"/>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
    <csbo:scope xml:lang="en">Output representation</csbo:scope>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R38">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#SpatialZone"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#SourceReference"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#GeometryDefinition"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PhysicalComponent"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#ComponentType"/>
        <csbo:ruleCondition xml:lang="en">When recording generation results in the common intermediate model JSON</csbo:ruleCondition>
        <csbo:ruleAction xml:lang="en">Put physical-component geometry in entities[].geometry and placement in entities[].pose. The meaning of hasGeometry and parameter records may be represented by these fields and entities[].properties without creating duplicate solids. When recording information or spatial entities such as ComponentType, SpatialZone, DrawingMention, GeometryDefinition or SourceReference as auxiliary entities, set geometry to null. Relationship target IDs must refer to IDs recorded in entities; record relationship evidence in source_evidence and confirmed, inferred or unresolved status in properties.status.</csbo:ruleAction>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <csbo:factId>F0880</csbo:factId>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b698">
