    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R14">
        <csbo:ruleAction xml:lang="en">Determine component counts, cable arrangements, spacing, symmetry, pylon count and section types from project evidence. A cable-stayed bridge classification alone does not establish equal spacing, symmetry or a specific cable count.</csbo:ruleAction>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CableStayedBridge"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StayCable"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#Pylon"/>
        <csbo:ruleCondition xml:lang="en">When a layout drawing shows a repeated pattern</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
