  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b657">
    <csbo:evidenceBasis>LOCAL</csbo:evidenceBasis>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:factId>F0657</csbo:factId>
    <csbo:scope xml:lang="en">Anchorage</csbo:scope>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#GenerationRule"/>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R04">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StayCableAnchorage"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#partOf"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#mountedOn"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#stayAnchoredAt"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StayCable"/>
        <csbo:ruleAction xml:lang="en">Record StayCable -&gt; stayAnchoredAt -&gt; StayCableAnchorage -&gt; mountedOn -&gt; the actual host component. Link anchorage plates, tubes and similar parts to the anchorage through confirmed assembly relationships. These relationships do not automatically determine specific coordinates or rigid connection conditions.</csbo:ruleAction>
        <csbo:ruleCondition xml:lang="en">When stay-cable anchorage details and the installation host are confirmed</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b360">
    <owl:annotatedSource rdf:resource="https://example.org/csbo#EvidenceEntity"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
    <csbo:scope xml:lang="en">Domain definition</csbo:scope>
    <csbo:factId>F0360</csbo:factId>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#Entity"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b670">
    <csbo:scope xml:lang="en">Anchorage</csbo:scope>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R05">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PrestressingAnchorage"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StayCableAnchorage"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PrestressingBar"/>
        <csbo:ruleCondition xml:lang="en">When PT BAR or prestressing strand is also shown near an anchorage</csbo:ruleCondition>
        <csbo:ruleAction xml:lang="en">Represent the main stay cable and tendons reinforcing the anchorage region as separate entities. Do not automatically merge plates or anchorages of the reinforcing tendons with the stay-cable anchorage.</csbo:ruleAction>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#StayCableAnchorage"/>
    <csbo:factId>F0670</csbo:factId>
    <csbo:evidenceBasis>LOCAL</csbo:evidenceBasis>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b843">
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#LoftGeometry"/>
    <csbo:factId>F0843</csbo:factId>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:evidenceBasis>LOCAL</csbo:evidenceBasis>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R33">
        <csbo:ruleCondition xml:lang="en">When generating pylons or girders with section-based sweeps or lofts</csbo:ruleCondition>
        <csbo:ruleAction xml:lang="en">Link the reference path, applicable stations or zones of sections, section orientation and transition zones. Do not assume a constant section throughout from one section drawing. For lofting, record evidence for section order, profile correspondence and transition method.</csbo:ruleAction>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CrossSectionDefinition"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#usesSection"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#LoftGeometry"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#SectionAssignment"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#SweepGeometry"/>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <csbo:scope xml:lang="en">Section application</csbo:scope>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b732">
    <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
    <csbo:scope xml:lang="en">Superstructure</csbo:scope>
    <csbo:factId>F0732</csbo:factId>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R16">
        <csbo:ruleAction xml:lang="en">Record partOf relationships between the overall stiffening girder and its internal components. Generate only components included in the model detail level; do not add internal plates absent from the drawings solely from a general type.</csbo:ruleAction>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#Stiffener"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#Diaphragm"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#TransverseBeam"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#partOf"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StiffeningGirder"/>
        <csbo:ruleCondition xml:lang="en">When stiffening girders, transverse beams, diaphragms and stiffeners appear together</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#GenerationRule"/>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b804">
    <csbo:factId>F0804</csbo:factId>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
