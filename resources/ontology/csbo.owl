  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b497">
    <csbo:scope xml:lang="en">Domain definition</csbo:scope>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <owl:annotatedTarget xml:lang="en">Links a point to a role describing its physical meaning. Do not merge points with different roles solely because they share coordinates.</owl:annotatedTarget>
    <owl:annotatedSource>
      <owl:ObjectProperty rdf:about="https://example.org/csbo#pointRole">
        <rdfs:domain rdf:resource="https://example.org/csbo#ReferencePoint"/>
        <rdfs:range rdf:resource="https://example.org/csbo#ReferencePointRole"/>
        <rdfs:label xml:lang="en">has a reference point role</rdfs:label>
        <skos:definition xml:lang="en">Links a point to a role describing its physical meaning. Do not merge points with different roles solely because they share coordinates.</skos:definition>
      </owl:ObjectProperty>
    </owl:annotatedSource>
    <csbo:factId>F0497</csbo:factId>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b685">
    <csbo:factId>F0685</csbo:factId>
    <owl:annotatedTarget xml:lang="en">When combining cable length, distance between anchorages and direction angles</owl:annotatedTarget>
