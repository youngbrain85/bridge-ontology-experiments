      <csbo:GenerationRule rdf:about="https://example.org/csbo#R32">
        <csbo:ruleAction xml:lang="en">Distinguish reference planes, signs, angular units and axis order for side-view or front-view projection angles and in-plane angles. Do not automatically equate the direction joining two cable reference points with the end tangent direction accounting for sag.</csbo:ruleAction>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CoordinateFrame"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#AnchorageBearingPlate"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CablePath"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#AnchorageTube"/>
        <csbo:ruleCondition xml:lang="en">When using cable, anchorage plate or tube angles and axis directions</csbo:ruleCondition>
      </csbo:GenerationRule>
