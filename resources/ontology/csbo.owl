    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R08">
        <csbo:ruleAction xml:lang="en">Check that values use the same pre- or post-stressing state and reference-point definitions. Do not automatically equate straight distance between anchorage points, curved path length, fabrication length and stressed cable length.</csbo:ruleAction>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#atState"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CablePath"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#ParameterAssignment"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#ModelState"/>
        <csbo:ruleCondition xml:lang="en">When combining cable length, distance between anchorages and direction angles</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#ruleCondition"/>
    <csbo:evidenceBasis>LOCAL</csbo:evidenceBasis>
  </owl:Axiom>
