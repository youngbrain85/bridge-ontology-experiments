  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b584">
    <owl:annotatedTarget rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:scope xml:lang="en">Domain definition</csbo:scope>
    <csbo:factId>F0584</csbo:factId>
    <owl:annotatedSource>
      <owl:DatatypeProperty rdf:about="https://example.org/csbo#numericValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">Numeric value</rdfs:label>
        <skos:definition xml:lang="en">An evidenced numeric value. Do not record an unresolved value as an arbitrary zero.</skos:definition>
        <rdfs:domain rdf:resource="https://example.org/csbo#ParameterAssignment"/>
      </owl:DatatypeProperty>
    </owl:annotatedSource>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b246">
    <csbo:factId>F0246</csbo:factId>
    <owl:annotatedProperty>
      <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    </owl:annotatedProperty>
    <owl:annotatedTarget xml:lang="en">A cable transmitting power, communication or data. Distinguish it from stay cables and tie-down cables.</owl:annotatedTarget>
    <csbo:scope xml:lang="en">Domain definition</csbo:scope>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <owl:annotatedSource rdf:resource="https://example.org/csbo#ElectricalCable"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b864">
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#AnchorageAssembly"/>
    <csbo:scope xml:lang="en">Anchorage zones</csbo:scope>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R36">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#AnchorageZone"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#partOf"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#AnchorageAssembly"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#locatedIn"/>
        <csbo:ruleCondition xml:lang="en">When multiple parts appear within a pylon or stiffening-girder anchorage region</csbo:ruleCondition>
        <csbo:ruleAction xml:lang="en">Distinguish AnchorageZone as a space from AnchorageAssembly as a physical assembly. Do not automatically merge all reinforcing bars, PT bars and anchorage plates in the same zone into one anchorage's components.</csbo:ruleAction>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedProperty>
      <owl:AnnotationProperty rdf:about="https://example.org/csbo#relatedConcept"/>
    </owl:annotatedProperty>
    <csbo:factId>F0864</csbo:factId>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
  </owl:Axiom>
