    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R09">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CableSegment"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#AnchorageAssembly"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CablePath"/>
        <csbo:ruleAction xml:lang="en">Segment according to saddles, deviation points, splices and similar features confirmed in the drawings, and according to the model detail level. Do not impose a universal constraint that every stay cable has exactly two physical anchorage assemblies.</csbo:ruleAction>
        <csbo:ruleCondition xml:lang="en">When dividing a cable into one or multiple segments</csbo:ruleCondition>
      </csbo:GenerationRule>
