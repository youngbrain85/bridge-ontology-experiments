  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b764">
    <csbo:evidenceBasis>IFC</csbo:evidenceBasis>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:scope xml:lang="en">zone</csbo:scope>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
    <csbo:factId>F0764</csbo:factId>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#PhysicalComponent"/>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R20">
        <csbo:ruleAction xml:lang="en">Identify PylonZone, PierZone and DeckZone separately from physical components such as Pylon, Pier and Girder, and connect them with locatedIn. Do not model a spatial subdivision as a physical component.</csbo:ruleAction>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PhysicalComponent"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#SpatialZone"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#locatedIn"/>
        <csbo:ruleCondition xml:lang="en">When recording pylon, pier or superstructure zones and their physical components</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b778">
    <csbo:evidenceBasis>LOCAL</csbo:evidenceBasis>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R23">
        <csbo:ruleAction xml:lang="en">Preserve original content identifiers and derivation relationships. Do not count copies or enlarged captures of the same drawing as multiple independent design sources.</csbo:ruleAction>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#sha256"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#DrawingFile"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#derivedFrom"/>
        <csbo:ruleCondition xml:lang="en">When using classified-folder copies, PDFs, PNGs and DXFs together</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#GenerationRule"/>
    <csbo:scope xml:lang="en">Traceability</csbo:scope>
    <csbo:factId>F0778</csbo:factId>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b407">
    <owl:annotatedSource>
      <owl:ObjectProperty rdf:about="https://example.org/csbo#zonePartOf">
        <rdfs:label xml:lang="en">is part of a spatial subdivision</rdfs:label>
        <rdfs:range rdf:resource="https://example.org/csbo#AssetEntity"/>
        <rdfs:domain rdf:resource="https://example.org/csbo#SpatialZone"/>
        <skos:definition xml:lang="en">Indicates that a zone belongs to the spatial subdivision of a larger zone or bridge. Distinguish it from physical assembly relationships.</skos:definition>
      </owl:ObjectProperty>
    </owl:annotatedSource>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:factId>F0407</csbo:factId>
