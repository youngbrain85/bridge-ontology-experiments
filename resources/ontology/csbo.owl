  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b460">
    <csbo:factId>F0460</csbo:factId>
    <csbo:scope xml:lang="en">Domain definition</csbo:scope>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <owl:annotatedTarget xml:lang="en">Links geometry generation to the applicable section and its station or zone information.</owl:annotatedTarget>
    <owl:annotatedSource>
      <owl:ObjectProperty rdf:about="https://example.org/csbo#hasSectionAssignment">
        <rdfs:domain rdf:resource="https://example.org/csbo#GeometryDefinition"/>
        <rdfs:label xml:lang="en">has a section assignment</rdfs:label>
        <skos:definition xml:lang="en">Links geometry generation to the applicable section and its station or zone information.</skos:definition>
        <rdfs:range rdf:resource="https://example.org/csbo#SectionAssignment"/>
      </owl:ObjectProperty>
    </owl:annotatedSource>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b798">
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <csbo:factId>F0798</csbo:factId>
    <csbo:scope xml:lang="en">Missing information</csbo:scope>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#ParameterAssignment"/>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R26">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#GeometryDefinition"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#ParameterAssignment"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#valueStatus"/>
        <csbo:ruleAction xml:lang="en">Preserve the identified component and confirmed information; state unresolved values, conflicts and omitted geometry. Continue describing the model to the extent possible even when not every detail is known.</csbo:ruleAction>
        <csbo:ruleCondition xml:lang="en">When the component type is known but some dimensions or relationships are unknown</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b313">
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
    <csbo:factId>F0313</csbo:factId>
    <owl:annotatedTarget xml:lang="en">A tube-generation representation using a path and outer and inner sections. Preserve unknown outside diameter, inside diameter or thickness values as unresolved.</owl:annotatedTarget>
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <owl:annotatedSource rdf:resource="https://example.org/csbo#TubeGeometry"/>
    <csbo:scope xml:lang="en">Domain definition</csbo:scope>
  </owl:Axiom>
