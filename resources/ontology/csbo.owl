    <csbo:scope xml:lang="en">Geometry</csbo:scope>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#GeometryDefinition"/>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R27">
        <csbo:ruleAction xml:lang="en">Distinguish section reference lines, centerlines and outlines, and the boundaries of protective sheaths, metallic tensile elements and anchorage parts. Do not automatically reuse one part's diameter or thickness for another part.</csbo:ruleAction>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#GeometryDefinition"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#CableSheath"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#AnchorageTube"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StayCable"/>
        <csbo:ruleCondition xml:lang="en">When using widths, thicknesses, diameters and outside diameters to generate solids</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <owl:annotatedProperty rdf:resource="https://example.org/csbo#relatedConcept"/>
  </owl:Axiom>
  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b813">
    <csbo:evidenceBasis>IFC</csbo:evidenceBasis>
    <owl:annotatedTarget rdf:resource="https://example.org/csbo#GenerationRule"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
    <csbo:factId>F0813</csbo:factId>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R29">
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PylonZone"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StayCable"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#StayCableAnchorage"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#Pylon"/>
        <csbo:ruleAction xml:lang="en">Distinguish physical and spatial roles when mapping. Do not map a stay cable to the electrical or communication IfcCableSegment, and do not equate a stay-cable anchorage with IfcTendonAnchor in every case.</csbo:ruleAction>
        <csbo:ruleCondition xml:lang="en">When selecting types for IFC export</csbo:ruleCondition>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <csbo:scope xml:lang="en">Standards mapping</csbo:scope>
  </owl:Axiom>
