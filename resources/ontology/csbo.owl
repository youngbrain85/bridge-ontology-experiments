  <owl:Axiom rdf:nodeID="n024588fc633a476a8c503029832c0320b640">
    <csbo:evidenceBasis>DESIGN</csbo:evidenceBasis>
    <owl:annotatedTarget xml:lang="en">Compare component numbers, installation zones, referenced details and revisions to determine whether mentions refer to the same physical instance. Initially keep repeated depictions as separate DrawingMention entities, linking them to the same component only when supported by evidence.</owl:annotatedTarget>
    <csbo:factId>F0640</csbo:factId>
    <owl:annotatedSource>
      <csbo:GenerationRule rdf:about="https://example.org/csbo#R01">
        <csbo:ruleCondition xml:lang="en">When the same name or component annotation appears in several views or files</csbo:ruleCondition>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#DrawingMention"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#refersTo"/>
        <csbo:relatedConcept rdf:resource="https://example.org/csbo#PhysicalComponent"/>
        <csbo:ruleAction xml:lang="en">Compare component numbers, installation zones, referenced details and revisions to determine whether mentions refer to the same physical instance. Initially keep repeated depictions as separate DrawingMention entities, linking them to the same component only when supported by evidence.</csbo:ruleAction>
      </csbo:GenerationRule>
    </owl:annotatedSource>
    <csbo:scope xml:lang="en">Component identification</csbo:scope>
